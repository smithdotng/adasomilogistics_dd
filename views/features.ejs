                    </div>
                    <div class="feature-content">
                        <h2>Staff Management</h2>
                        <p>Comprehensive workforce management with qualification tracking, DBS monitoring, and skills matching.</p>
                        <ul class="feature-list">
                            <li><i class="fas fa-check"></i> Staff profiles</li>
                            <li><i class="fas fa-check"></i> Qualification tracking</li>
                            <li><i class="fas fa-check"></i> DBS monitoring</li>
                            <li><i class="fas fa-check"></i> Skills matrix</li>
                            <li><i class="fas fa-check"></i> Training records</li>
                            <li><i class="fas fa-check"></i> Availability calendar</li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="feature-image">
                        <img src="/assets/images/feature-staff.jpg" alt="Staff Management" class="img-fluid">
                    </div>
                </div>
            </div>

            <!-- Feature 3 -->
            <div class="feature-item row align-items-center">
                <div class="col-lg-6">
                    <div class="feature-icon-large">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <div class="feature-content">
                        <h2>Intelligent Scheduling</h2>
                        <p>Smart scheduling that matches the right carer to each client based on skills, location, and availability.</p>
                        <ul class="feature-list">
                            <li><i class="fas fa-check"></i> Automated rostering</li>
                            <li><i class="fas fa-check"></i> Skills matching</li>
                            <li><i class="fas fa-check"></i> Location optimisation</li>
                            <li><i class="fas fa-check"></i> Recurring visits</li>
                            <li><i class="fas fa-check"></i> Real-time updates</li>
                            <li><i class="fas fa-check"></i> Conflict prevention</li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="feature-image">
                        <img src="/assets/images/feature-scheduling.jpg" alt="Intelligent Scheduling" class="img-fluid">
                    </div>
                </div>
            </div>

            <!-- Feature 4 -->
            <div class="feature-item row align-items-center flex-row-reverse">
                <div class="col-lg-6">
                    <div class="feature-icon-large">
                        <i class="fas fa-file-medical"></i>
                    </div>
                    <div class="feature-content">
                        <h2>Digital Care Plans</h2>
                        <p>Create and manage comprehensive digital care plans with medication tracking, risk assessments, and progress notes.</p>
                        <ul class="feature-list">
                            <li><i class="fas fa-check"></i> Personalised care plans</li>
                            <li><i class="fas fa-check"></i> Medication management</li>
                            <li><i class="fas fa-check"></i> Risk assessments</li>
                            <li><i class="fas fa-check"></i> Goal tracking</li>
                            <li><i class="fas fa-check"></i> Progress notes</li>
                            <li><i class="fas fa-check"></i> Review scheduling</li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="feature-image">
                        <img src="/assets/images/feature-care-plans.jpg" alt="Digital Care Plans" class="img-fluid">
                    </div>
                </div>
            </div>

            <!-- Feature 5 -->
            <div class="feature-item row align-items-center">
                <div class="col-lg-6">
                    <div class="feature-icon-large">
                        <i class="fas fa-mobile-alt"></i>
                    </div>
                    <div class="feature-content">
                        <h2>Mobile Interaction Logging</h2>
                        <p>Staff can log visits, observations, and tasks in real-time from any device. Offline capability included.</p>
                        <ul class="feature-list">
                            <li><i class="fas fa-check"></i> Real-time logging</li>
                            <li><i class="fas fa-check"></i> Offline mode</li>
                            <li><i class="fas fa-check"></i> Photo attachments</li>
                            <li><i class="fas fa-check"></i> Digital signatures</li>
                            <li><i class="fas fa-check"></i> Voice notes</li>
                            <li><i class="fas fa-check"></i> Visit verification</li>
                        </ul>
