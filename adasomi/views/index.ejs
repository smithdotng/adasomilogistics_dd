<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Home' }) %>
</head>
<body>
<%- include('partials/header') %>
<%- include('partials/flash') %>

<main>
    <section class="hero-peach">
        <div class="container position-relative">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <h1>Point-to-point dispatch for food businesses and everyday deliveries.</h1>
                    <p class="lead">Adasomi connects commercial operators — restaurant owners, food processors, food vendors and produce aggregators — with verified rider fleets and the public, in one escrow-secured logistics engine from kitchen to doorstep.</p>
                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a href="/register" class="btn btn-peach btn-lg">Get Started Free</a>
                        <a href="/how-it-works" class="btn btn-outline-light btn-lg">See How It Works</a>
                    </div>
                </div>
                <div class="col-lg-5 d-none d-lg-block">
                    <%- include('partials/illust-scooter') %>
                </div>
            </div>
        </div>
    </section>

    <section class="page-shell">
        <div class="container">
            <p class="section-title text-center">Built for the whole ecosystem</p>
            <h2 class="text-center mb-5">One platform, three kinds of dispatch</h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="role-card">
                        <%- include('partials/illust-storefront') %>
                        <div class="role-card-body">
                            <div class="role-icon"><i class="fa-solid fa-store"></i></div>
                            <h5>Merchants (Commercial Operators)</h5>
                            <p class="text-muted mb-2">Any food or produce business that needs its own dispatch fleet — specifically:</p>
                            <ul class="text-muted small mb-0 ps-3">
                                <li><strong>Restaurant owners</strong> dispatching customer orders</li>
                                <li><strong>Food processors</strong> moving bulk or packaged goods</li>
                                <li><strong>Food vendors</strong> serving walk-in &amp; online orders</li>
                                <li><strong>Produce aggregators</strong> distributing fresh stock</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="role-card">
                        <%- include('partials/illust-parcel') %>
                        <div class="role-card-body">
                            <div class="role-icon"><i class="fa-solid fa-user"></i></div>
                            <h5>Public Users</h5>
                            <p class="text-muted mb-0">Drop a pickup and drop-off pin, see the logistics fee instantly, and get matched with an available verified rider nearby.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="role-card">
                        <%- include('partials/illust-rider-badge') %>
                        <div class="role-card-body">
                            <div class="role-icon"><i class="fa-solid fa-motorcycle"></i></div>
                            <h5>Riders / Fleets</h5>
                            <p class="text-muted mb-0">Register independently, submit KYC and vehicle details, then get verified by one or more operators and start earning from your wallet on every completed trip.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="page-shell" style="background:var(--thm-bg-soft);">
        <div class="container">
            <p class="section-title text-center">Order dispatch &amp; dynamic pricing</p>
            <h2 class="text-center mb-5">From order to escrow-secured payout</h2>
            <div class="row g-3">
                <div class="col-6 col-md-2-4 col-lg">
                    <div class="flow-step">
                        <div class="flow-number">1</div>
                        <h6>Order Created</h6>
                        <p class="text-muted small">Items + destination, or a public pickup/drop-off pin.</p>
                    </div>
                </div>
                <div class="col-6 col-lg">
                    <div class="flow-step">
                        <div class="flow-number">2</div>
                        <h6>Rider Assigned</h6>
                        <p class="text-muted small">Manual pick or broadcast, first-come first-served.</p>
                    </div>
                </div>
                <div class="col-6 col-lg">
                    <div class="flow-step">
                        <div class="flow-number">3</div>
                        <h6>Escrow Funded</h6>
                        <p class="text-muted small">Gross value held safely in the Adasomi vault.</p>
                    </div>
                </div>
                <div class="col-6 col-lg">
                    <div class="flow-step">
                        <div class="flow-number">4</div>
                        <h6>OTP &amp; PIN</h6>
                        <p class="text-muted small">Pickup verified by OTP, delivery confirmed by PIN.</p>
                    </div>
                </div>
                <div class="col-6 col-lg">
                    <div class="flow-step">
                        <div class="flow-number">5</div>
                        <h6>Payout Settled</h6>
                        <p class="text-muted small">Item value to merchant, logistics fee to rider.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="page-shell">
        <div class="container text-center">
            <h2>Ready to move something?</h2>
            <p class="text-muted mb-4">Join as a commercial operator, an independent rider, or simply request a delivery.</p>
            <a href="/register" class="btn btn-peach btn-lg">Create your free account</a>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
</body>
</html>
