<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create New Interaction || Care System Admin</title>
    
    <!-- favicons Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicons/favicon-16x16.png" />
    <link rel="manifest" href="/assets/images/favicons/site.webmanifest" />
    <meta name="description" content="Care System Admin - Create New Interaction" />

    <!-- fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <!-- CSS libraries -->
    <link rel="stylesheet" href="/assets/vendors/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/assets/vendors/animate/animate.min.css" />
    <link rel="stylesheet" href="/assets/vendors/animate/custom-animate.css" />
    <link rel="stylesheet" href="/assets/vendors/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="/assets/vendors/jarallax/jarallax.css" />
    <link rel="stylesheet" href="/assets/vendors/jquery-magnific-popup/jquery.magnific-popup.css" />
    <link rel="stylesheet" href="/assets/vendors/nouislider/nouislider.min.css" />
    <link rel="stylesheet" href="/assets/vendors/nouislider/nouislider.pips.css" />
    <link rel="stylesheet" href="/assets/vendors/odometer/odometer.min.css" />
    <link rel="stylesheet" href="/assets/vendors/swiper/swiper.min.css" />
    <link rel="stylesheet" href="/assets/vendors/sominx-icons/style.css">
    <link rel="stylesheet" href="/assets/vendors/tiny-slider/tiny-slider.min.css" />
    <link rel="stylesheet" href="/assets/vendors/reey-font/stylesheet.css" />
    <link rel="stylesheet" href="/assets/vendors/owl-carousel/owl.carousel.min.css" />
    <link rel="stylesheet" href="/assets/vendors/owl-carousel/owl.theme.default.min.css" />
    <link rel="stylesheet" href="/assets/vendors/twentytwenty/twentytwenty.css" />
    <link rel="stylesheet" href="/assets/vendors/bxslider/jquery.bxslider.css" />
    <link rel="stylesheet" href="/assets/vendors/bootstrap-select/css/bootstrap-select.min.css" />
    <link rel="stylesheet" href="/assets/vendors/vegas/vegas.min.css" />
    <link rel="stylesheet" href="/assets/vendors/jquery-ui/jquery-ui.css" />
    <link rel="stylesheet" href="/assets/vendors/timepicker/timePicker.css" />

    <!-- template styles -->
    <link rel="stylesheet" href="/assets/css/sominx.css" />
    <link rel="stylesheet" href="/assets/css/sominx-responsive.css" />
    
    <!-- Admin Interaction Styles -->
    <style>
        :root {
            --admin-primary: #2c3e50;
            --admin-secondary: #3498db;
            --admin-success: #27ae60;
            --admin-warning: #f39c12;
            --admin-danger: #e74c3c;
            --admin-info: #17a2b8;
        }
        
        .admin-form-card {
            background: #fff;
            border-radius: 10px;
            padding: 40px;
            margin-bottom: 30px;
            box-shadow: 0px 10px 60px 0px rgba(0, 0, 0, 0.07);
        }
        
        .form-section {
            border-left: 4px solid var(--admin-primary);
            padding-left: 20px;
            margin-bottom: 40px;
        }
        
        .form-section-title {
            font-size: 1.4rem;
            font-weight: 600;
            color: var(--admin-primary);
            margin-bottom: 25px;
            padding-bottom: 10px;
            border-bottom: 2px solid #f0f0f0;
        }
        
        .form-label {
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 10px;
            font-size: 0.95rem;
        }
        
        .required:after {
            content: " *";
            color: #e74c3c;
        }
        
        .form-control, .form-select, .form-textarea {
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            padding: 12px 15px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }
        
        .form-control:focus, .form-select:focus, .form-textarea:focus {
            border-color: var(--admin-primary);
            box-shadow: 0 0 0 0.2rem rgba(44, 62, 80, 0.15);
        }
        
        .form-textarea {
            min-height: 120px;
            resize: vertical;
        }
        
        .btn-admin-primary {
            background: var(--admin-primary);
            border-color: var(--admin-primary);
            color: white;
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .btn-admin-primary:hover {
            background: #1a252f;
            border-color: #1a252f;
            color: white;
        }
        
        .form-help-text {
            font-size: 0.85rem;
            color: #7f8c8d;
            margin-top: 5px;
        }
        
        .client-operator-info {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 25px;
            border-left: 4px solid var(--admin-secondary);
        }
        
        .info-label {
            font-weight: 600;
            color: #2c3e50;
            min-width: 100px;
        }
        
        .info-value {
            color: #34495e;
        }
        
        .interaction-type-option {
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-bottom: 10px;
            background: white;
        }
        
        .interaction-type-option:hover {
            border-color: var(--admin-primary);
            background: rgba(44, 62, 80, 0.03);
            transform: translateY(-2px);
        }
        
        .interaction-type-option.active {
            border-color: var(--admin-primary);
            background: rgba(44, 62, 80, 0.1);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        }
        
        .type-icon {
            font-size: 28px;
            margin-bottom: 10px;
            display: block;
        }
        
        .type-name {
            font-weight: 600;
            font-size: 0.9rem;
            color: #2c3e50;
        }
        
        .type-description {
            font-size: 0.8rem;
            color: #7f8c8d;
            margin-top: 5px;
        }
        
        .form-row-gap {
            margin-bottom: 20px;
        }
        
        .input-group-with-icon {
            position: relative;
        }
        
        .input-group-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #7f8c8d;
            z-index: 4;
        }
        
        .input-group-with-icon .form-control {
            padding-left: 45px;
        }
        
        .status-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            margin-right: 5px;
        }
        
        .status-draft { background: #f8f9fa; color: #6c757d; }
        .status-completed { background: #d4edda; color: #155724; }
        .status-cancelled { background: #f8d7da; color: #721c24; }
        .status-needs_review { background: #fff3cd; color: #856404; }
        
        .location-option {
            display: inline-flex;
            align-items: center;
            margin-right: 15px;
            margin-bottom: 10px;
        }
        
        .location-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #f8f9fa;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
            color: var(--admin-primary);
            border: 2px solid #e9ecef;
        }
        
        .error-field {
            border-color: #e74c3c !important;
        }
        
        .error-message {
            color: #e74c3c;
            font-size: 0.85rem;
            margin-top: 5px;
        }
        
        .form-navigation {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
            margin-top: 30px;
            border-top: 2px solid #e9ecef;
        }
        
        .page-header-admin {
            background: linear-gradient(135deg, var(--admin-primary) 0%, #3498db 100%);
            color: white;
            padding: 40px 0;
            margin-bottom: 40px;
        }
        
        .page-header-admin h2 {
            color: white;
            margin-bottom: 10px;
        }
        
        .page-header-admin .breadcrumb {
            background: transparent;
            padding: 0;
            margin-bottom: 0;
        }
        
        .page-header-admin .breadcrumb-item a {
            color: rgba(255, 255, 255, 0.8);
        }
        
        .page-header-admin .breadcrumb-item.active {
            color: white;
        }
        
        .type-visit { color: #3498db; }
        .type-phone_call { color: #27ae60; }
        .type-video_call { color: #9b59b6; }
        .type-email { color: #e67e22; }
        .type-assessment { color: #1abc9c; }
        .type-medication { color: #e74c3c; }
        .type-emergency { color: #c0392b; }
        .type-routine_check { color: #f39c12; }
        .type-family_meeting { color: #8e44ad; }
    </style>
</head>

<body>
    <div class="preloader">
        <img class="preloader__image" width="60" src="/assets/images/loader.png" alt="" />
    </div>
    <!-- /.preloader -->
    
    <div class="page-wrapper">
        <!-- Header Start -->
        <header class="main-header clearfix">
            <nav class="main-menu clearfix">
                <div class="main-menu-wrapper clearfix">
                    <div class="main-menu-wrapper-inner clearfix">
                        <div class="main-menu-wrapper__left clearfix">
                            <div class="main-menu-wrapper__logo">
                                <a href="/"><img src="/assets/images/resources/logo-1.jpg" alt="Care System"></a>
                            </div>
                            <div class="main-menu-wrapper__main-menu">
                                <a href="#" class="mobile-nav__toggler"><i class="fa fa-bars"></i></a>
                                <ul class="main-menu__list">
                                    <li><a href="/admin/dashboard">Dashboard</a></li>
                                    <li><a href="/admin/clients">Clients</a></li>
                                    <li><a href="/admin/operators">Operators</a></li>
                                    <li class="current"><a href="/admin/interactions">Interactions</a></li>
                                    <li><a href="/admin/reports">Reports</a></li>
                                    <li><a href="/admin/settings">Settings</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="main-menu-wrapper__right">
                            <div class="main-menu-wrapper__call">
                                <div class="main-menu-wrapper__call-icon">
                                    <span class="icon-user-check"></span>
                                </div>
                                <div class="main-menu-wrapper__call-number">
                                    <p>Admin Panel</p>
                                    <a href="/admin/profile"><%= user.firstName %> <%= user.lastName %></a>
                                </div>
                            </div>
                            <div class="main-menu-wrapper__search-box">
                                <a href="/logout" class="main-menu-wrapper__logout" title="Logout">
                                    <i class="fas fa-sign-out-alt"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
        <!-- Header End -->

        <div class="stricky-header stricked-menu main-menu">
            <div class="sticky-header__content"></div>
        </div>

        <!-- Page Header -->
        <section class="page-header-admin">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <h2 class="mb-3">
                            <i class="fas fa-plus-circle me-2"></i>
                            Create New Interaction
                        </h2>
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/admin/dashboard">Admin</a></li>
                                <li class="breadcrumb-item"><a href="/admin/interactions">Interactions</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Create New</li>
                            </ol>
                        </nav>
                    </div>
                    <div class="col-lg-4 text-lg-end">
                        <a href="/admin/interactions" class="thm-btn" style="background: rgba(255, 255, 255, 0.2); border: 1px solid rgba(255, 255, 255, 0.3);">
                            <i class="fas fa-arrow-left me-2"></i>Back to Interactions
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Main Content -->
        <section class="interaction-create-content pt-80 pb-120">
            <div class="container">
                <!-- Flash Messages -->
                <% if (typeof messages !== 'undefined' && messages.error && messages.error.length > 0) { %>
                    <div class="alert alert-danger alert-dismissible fade show mb-4 wow fadeInUp" data-wow-delay="100ms" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle me-3 fs-4"></i>
                            <div><%= messages.error %></div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>
                
                <% if (typeof messages !== 'undefined' && messages.success && messages.success.length > 0) { %>
                    <div class="alert alert-success alert-dismissible fade show mb-4 wow fadeInUp" data-wow-delay="100ms" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-check-circle me-3 fs-4"></i>
                            <div><%= messages.success %></div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <div class="admin-form-card wow fadeInUp" data-wow-delay="200ms">
                    <form action="/admin/interactions" method="POST" id="createInteractionForm" class="needs-validation" novalidate>
                        <!-- Client & Operator Selection -->
                        <div class="form-section mb-5">
                            <h4 class="form-section-title">
                                <i class="fas fa-users me-2"></i>Client & Operator
                            </h4>
                            
                            <div class="row">
                                <div class="col-md-6 form-row-gap">
                                    <label for="client" class="form-label required">
                                        <i class="fas fa-user me-2"></i>Select Client
                                    </label>
                                    <select class="form-select" id="client" name="client" required>
                                        <option value="">-- Select Client --</option>
                                        <% clients.forEach(client => { %>
                                            <option value="<%= client._id %>">
                                                <%= client.firstName %> <%= client.lastName %> 
                                                <% if (client.referenceId) { %>
                                                    (ID: <%= client.referenceId %>)
                                                <% } %>
                                            </option>
                                        <% }); %>
                                    </select>
                                    <div class="form-help-text">The client this interaction is about</div>
                                    <div class="invalid-feedback">Please select a client</div>
                                </div>
                                
                                <div class="col-md-6 form-row-gap">
                                    <label for="operator" class="form-label required">
                                        <i class="fas fa-user-md me-2"></i>Select Operator
                                    </label>
                                    <select class="form-select" id="operator" name="operator" required>
                                        <option value="">-- Select Operator --</option>
                                        <% operators.forEach(operator => { %>
                                            <option value="<%= operator._id %>">
                                                <%= operator.firstName %> <%= operator.lastName %> 
                                                (<%= operator.email %>)
                                            </option>
                                        <% }); %>
                                    </select>
                                    <div class="form-help-text">The operator who performed the interaction</div>
                                    <div class="invalid-feedback">Please select an operator</div>
                                </div>
                            </div>
                        </div>

                        <!-- Interaction Details -->
                        <div class="form-section mb-5">
                            <h4 class="form-section-title">
                                <i class="fas fa-info-circle me-2"></i>Interaction Details
                            </h4>
                            
                            <div class="row">
                                <div class="col-md-8 form-row-gap">
                                    <label for="title" class="form-label required">
                                        <i class="fas fa-heading me-2"></i>Interaction Title
                                    </label>
                                    <div class="input-group-with-icon">
                                        <i class="fas fa-heading input-group-icon"></i>
                                        <input type="text" class="form-control" id="title" name="title" 
                                               placeholder="e.g., Weekly Health Check, Medication Administration, Family Consultation" required>
                                    </div>
                                    <div class="form-help-text">Provide a clear, descriptive title for this interaction</div>
                                    <div class="invalid-feedback">Please provide a title for this interaction</div>
                                </div>
                                
                                <div class="col-md-4 form-row-gap">
                                    <label for="status" class="form-label required">
                                        <i class="fas fa-tasks me-2"></i>Status
                                    </label>
                                    <select class="form-select" id="status" name="status" required>
                                        <option value="draft">Draft</option>
                                        <option value="completed" selected>Completed</option>
                                        <option value="cancelled">Cancelled</option>
                                        <option value="needs_review">Needs Review</option>
                                    </select>
                                    <div class="form-help-text">Current status of this interaction</div>
                                </div>
                            </div>
                            
                            <div class="row mt-4">
                                <div class="col-12 form-row-gap">
                                    <label class="form-label required">
                                        <i class="fas fa-stethoscope me-2"></i>Interaction Type
                                    </label>
                                    <div class="row" id="typeSelection">
                                        <!-- Visit -->
                                        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                                            <div class="interaction-type-option" data-type="visit">
                                                <i class="fas fa-home type-icon type-visit"></i>
                                                <div class="type-name">Visit</div>
                                                <div class="type-description">Home or facility visit</div>
                                            </div>
                                            <input type="radio" name="type" value="visit" class="d-none" required>
                                        </div>
                                        
                                        <!-- Phone Call -->
                                        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                                            <div class="interaction-type-option" data-type="phone_call">
                                                <i class="fas fa-phone type-icon type-phone_call"></i>
                                                <div class="type-name">Phone Call</div>
                                                <div class="type-description">Telephone conversation</div>
                                            </div>
                                            <input type="radio" name="type" value="phone_call" class="d-none">
                                        </div>
                                        
                                        <!-- Video Call -->
                                        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                                            <div class="interaction-type-option" data-type="video_call">
                                                <i class="fas fa-video type-icon type-video_call"></i>
                                                <div class="type-name">Video Call</div>
                                                <div class="type-description">Virtual meeting</div>
                                            </div>
                                            <input type="radio" name="type" value="video_call" class="d-none">
                                        </div>
                                        
                                        <!-- Email -->
                                        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                                            <div class="interaction-type-option" data-type="email">
                                                <i class="fas fa-envelope type-icon type-email"></i>
                                                <div class="type-name">Email</div>
                                                <div class="type-description">Electronic communication</div>
                                            </div>
                                            <input type="radio" name="type" value="email" class="d-none">
                                        </div>
                                        
                                        <!-- Assessment -->
                                        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                                            <div class="interaction-type-option" data-type="assessment">
                                                <i class="fas fa-clipboard-check type-icon type-assessment"></i>
                                                <div class="type-name">Assessment</div>
                                                <div class="type-description">Health evaluation</div>
                                            </div>
                                            <input type="radio" name="type" value="assessment" class="d-none">
                                        </div>
                                        
                                        <!-- Medication -->
                                        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                                            <div class="interaction-type-option" data-type="medication">
                                                <i class="fas fa-pills type-icon type-medication"></i>
                                                <div class="type-name">Medication</div>
                                                <div class="type-description">Drug administration</div>
                                            </div>
                                            <input type="radio" name="type" value="medication" class="d-none">
                                        </div>
                                        
                                        <!-- Emergency -->
                                        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                                            <div class="interaction-type-option" data-type="emergency">
                                                <i class="fas fa-exclamation-triangle type-icon type-emergency"></i>
                                                <div class="type-name">Emergency</div>
                                                <div class="type-description">Urgent situation</div>
                                            </div>
                                            <input type="radio" name="type" value="emergency" class="d-none">
                                        </div>
                                        
                                        <!-- Routine Check -->
                                        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                                            <div class="interaction-type-option" data-type="routine_check">
                                                <i class="fas fa-heartbeat type-icon type-routine_check"></i>
                                                <div class="type-name">Routine Check</div>
                                                <div class="type-description">Regular monitoring</div>
                                            </div>
                                            <input type="radio" name="type" value="routine_check" class="d-none">
                                        </div>
                                        
                                        <!-- Family Meeting -->
                                        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                                            <div class="interaction-type-option" data-type="family_meeting" data-active="true">
                                                <i class="fas fa-users type-icon type-family_meeting"></i>
                                                <div class="type-name">Family Meeting</div>
                                                <div class="type-description">Family consultation</div>
                                            </div>
                                            <input type="radio" name="type" value="family_meeting" class="d-none" checked>
                                        </div>
                                    </div>
                                    <div class="form-help-text">Select the type of interaction</div>
                                    <div class="invalid-feedback d-none" id="typeError">Please select an interaction type</div>
                                </div>
                            </div>
                        </div>

                        <!-- Time & Location -->
                        <div class="form-section mb-5">
                            <h4 class="form-section-title">
                                <i class="fas fa-clock me-2"></i>Time & Location
                            </h4>
                            
                            <div class="row">
                                <div class="col-md-6 form-row-gap">
                                    <label for="startTime" class="form-label required">
                                        <i class="fas fa-calendar-plus me-2"></i>Start Date & Time
                                    </label>
                                    <div class="input-group-with-icon">
                                        <i class="fas fa-calendar-alt input-group-icon"></i>
                                        <input type="datetime-local" class="form-control" id="startTime" name="startTime" required>
                                    </div>
                                    <div class="form-help-text">When the interaction began</div>
                                    <div class="invalid-feedback">Please select a start date and time</div>
                                </div>
                                
                                <div class="col-md-6 form-row-gap">
                                    <label for="endTime" class="form-label">
                                        <i class="fas fa-calendar-minus me-2"></i>End Date & Time
                                    </label>
                                    <div class="input-group-with-icon">
                                        <i class="fas fa-calendar-alt input-group-icon"></i>
                                        <input type="datetime-local" class="form-control" id="endTime" name="endTime">
                                    </div>
                                    <div class="form-help-text">When the interaction ended (leave blank if ongoing)</div>
                                </div>
                                
                                <div class="col-md-12 form-row-gap mt-3">
                                    <label for="location" class="form-label">
                                        <i class="fas fa-map-marker-alt me-2"></i>Location
                                    </label>
