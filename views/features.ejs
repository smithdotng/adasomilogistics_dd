                            <li><i class="fas fa-check"></i> Pension contributions</li>
                            <li><i class="fas fa-check"></i> Payslip generation</li>
                            <li><i class="fas fa-check"></i> BACS file export</li>
                            <li><i class="fas fa-check"></i> Payment history</li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="feature-image">
                        <img src="/assets/images/feature-payroll.jpg" alt="Payroll Management" class="img-fluid">
                    </div>
                </div>
