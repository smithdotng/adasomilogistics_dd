<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'Wallet' }) %>
</head>
<body>
<%- include('../partials/header') %>
<%- include('../partials/flash') %>

<main class="page-shell">
    <div class="container">
        <p class="section-title mb-1">Merchant Wallet</p>
        <h2 class="mb-4">Balance: ₦<%= wallet ? wallet.balance.toLocaleString() : '0' %></h2>

        <div class="card">
            <div class="card-header">Transaction History</div>
            <div class="card-body">
                <% if (!transactions.length) { %>
                    <div class="empty-state"><i class="fa-solid fa-receipt"></i><p>No transactions yet.</p></div>
                <% } else { %>
                <div class="table-responsive">
                    <table class="table">
                        <thead><tr><th>Date</th><th>Type</th><th>Order</th><th>Amount</th><th>Balance After</th></tr></thead>
                        <tbody>
                        <% transactions.forEach(function(t) { %>
                            <tr>
                                <td><%= moment(t.createdAt).format('MMM D, h:mm A') %></td>
                                <td><%= t.type.replace(/_/g,' ') %></td>
                                <td><%= t.order ? t.order.orderNumber : '—' %></td>
                                <td>₦<%= t.amount.toLocaleString() %></td>
                                <td>₦<%= t.balanceAfter.toLocaleString() %></td>
                            </tr>
                        <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } %>
            </div>
        </div>
    </div>
</main>
<%- include('../partials/footer') %>
</body>
</html>
