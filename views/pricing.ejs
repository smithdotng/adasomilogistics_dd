    <script>
        $(document).ready(function() {
            // Header scroll effect
            $(window).scroll(function() {
                if ($(this).scrollTop() > 100) {
                    $('#mainHeader').addClass('scrolled');
                } else {
                    $('#mainHeader').removeClass('scrolled');
                }
            });

            // Mobile menu toggle
            $('#mobileToggler').click(function(e) {
                e.preventDefault();
                $('#mobileMenu').addClass('open');
            });

            $('#mobileClose').click(function(e) {
                e.preventDefault();
                $('#mobileMenu').removeClass('open');
            });

            // Close mobile menu when clicking a link
            $('.mobile-menu-links a').click(function() {
                $('#mobileMenu').removeClass('open');
            });

            // Pricing toggle
            let isAnnual = false;
            
            $('#pricingToggle').click(function() {
                $(this).toggleClass('annual');
                isAnnual = !isAnnual;
                
                if (isAnnual) {
                    // Annual pricing (20% discount)
                    $('#essentialPrice').text('£470');
                    $('#essentialPeriod').text('per year (save £118)');
                    $('#professionalPrice').text('£950');
                    $('#professionalPeriod').text('per year (save £238)');
                    $('#enterprisePrice').text('£1,910');
                    $('#enterprisePeriod').text('per year (save £478)');
                } else {
                    // Monthly pricing
                    $('#essentialPrice').text('£49');
                    $('#essentialPeriod').text('per month');
                    $('#professionalPrice').text('£99');
                    $('#professionalPeriod').text('per month');
                    $('#enterprisePrice').text('£199');
                    $('#enterprisePeriod').text('per month');
                }
            });
        });
    </script>
