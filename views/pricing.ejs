<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pricing - Simple, Transparent Plans for UK Care Providers</title>
    <meta name="description" content="Choose the perfect plan for your care business. All plans include a 14-day free trial. No credit card required." />
    
    <!-- favicons Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicons/favicon-16x16.png" />
    <link rel="manifest" href="/assets/images/favicons/site.webmanifest" />

    <!-- fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

    <!-- CSS Links -->
    <link rel="stylesheet" href="/assets/vendors/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/assets/vendors/animate/animate.min.css" />
    <link rel="stylesheet" href="/assets/vendors/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="/assets/vendors/sominx-icons/style.css">

    <style>
        /* Same header and footer styles as previous pages */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Jost', sans-serif;
            color: #1e1e1e;
            overflow-x: hidden;
        }

        /* Header Styles - Copy from previous */
        .main-header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background: transparent;
            padding: 20px 0;
            z-index: 1000;
            transition: all 0.4s ease;
        }

        .main-header.scrolled {
            background: white;
            box-shadow: 0 2px 20px rgba(0,0,0,0.1);
            padding: 10px 0;
        }

        .main-header.scrolled .main-menu__list > li > a {
            color: #333;
        }

        .main-header.scrolled .btn-outline {
            border-color: #667eea;
            color: #667eea;
        }

        .main-header.scrolled .btn-outline:hover {
            background: #667eea;
            color: white;
        }

        .main-menu-wrapper {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .main-menu-wrapper__logo img {
            height: 40px;
            transition: all 0.3s ease;
        }

        .main-header.scrolled .main-menu-wrapper__logo img {
            filter: brightness(0.2);
        }

        .main-menu__list {
            display: flex;
            list-style: none;
            margin: 0;
            padding: 0;
            gap: 30px;
        }

        .main-menu__list > li > a {
            color: white;
            text-decoration: none;
            font-size: 16px;
            font-weight: 500;
            transition: color 0.3s ease;
        }

        .main-menu__list > li > a:hover,
        .main-menu__list > li > a.active {
            color: #ffd700;
        }

        .header-buttons {
            display: flex;
            gap: 15px;
        }

        .btn-outline {
            padding: 10px 25px;
            border: 2px solid white;
            border-radius: 30px;
            color: white;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .btn-outline:hover {
            background: white;
            color: #667eea;
        }

        .btn-solid {
            padding: 10px 25px;
            background: white;
            border: 2px solid white;
            border-radius: 30px;
            color: #667eea;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .btn-solid:hover {
            background: transparent;
            color: white;
        }

        .mobile-nav__toggler {
            display: none;
            color: white;
            font-size: 24px;
            cursor: pointer;
        }

        .main-header.scrolled .mobile-nav__toggler {
            color: #333;
        }

        /* Page Header */
        .page-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 150px 0 80px;
            color: white;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .page-header::before {
            content: '';
            position: absolute;
            top: -100px;
            right: -100px;
            width: 300px;
            height: 300px;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
        }

        .page-header::after {
            content: '';
            position: absolute;
            bottom: -100px;
            left: -100px;
            width: 300px;
            height: 300px;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
        }

        .page-header h1 {
            font-size: 48px;
            font-weight: 700;
            margin-bottom: 20px;
            position: relative;
        }

        .page-header p {
            font-size: 18px;
            max-width: 700px;
            margin: 0 auto;
            opacity: 0.9;
            position: relative;
        }

        .breadcrumb {
            background: transparent;
            justify-content: center;
            margin-top: 20px;
        }

        .breadcrumb a {
            color: rgba(255,255,255,0.8);
            text-decoration: none;
        }

        .breadcrumb .active {
            color: white;
        }

        /* Pricing Section */
        .pricing-section {
            padding: 100px 0;
            background: #f8f9fa;
        }

        .pricing-toggle {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            margin-bottom: 50px;
        }

        .toggle-option {
            font-size: 18px;
            font-weight: 500;
            color: #666;
        }

        .toggle-option.active {
            color: #667eea;
        }

        .toggle-switch {
            width: 60px;
            height: 30px;
            background: #e0e0e0;
            border-radius: 30px;
            position: relative;
            cursor: pointer;
        }

        .toggle-switch::after {
            content: '';
            position: absolute;
            top: 3px;
            left: 3px;
            width: 24px;
            height: 24px;
            background: #667eea;
            border-radius: 50%;
            transition: left 0.3s ease;
        }

        .toggle-switch.annual::after {
            left: 33px;
        }

        .pricing-card {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            transition: all 0.4s ease;
            height: 100%;
            position: relative;
            overflow: hidden;
            border: 1px solid #f0f0f0;
        }

        .pricing-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(102,126,234,0.1);
        }

        .pricing-card.featured {
            border: 2px solid #667eea;
            transform: scale(1.05);
            background: white;
        }

        .pricing-card.featured::before {
            content: 'MOST POPULAR';
            position: absolute;
            top: 20px;
            right: -30px;
            background: #667eea;
            color: white;
            padding: 5px 40px;
            font-size: 12px;
            font-weight: 600;
            transform: rotate(45deg);
        }

        .pricing-badge {
            display: inline-block;
            background: rgba(102,126,234,0.1);
            color: #667eea;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .pricing-card h3 {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .pricing-price {
            font-size: 48px;
            font-weight: 700;
            color: #1e1e1e;
            margin-bottom: 10px;
        }

        .pricing-price span {
            font-size: 16px;
            color: #999;
            font-weight: 400;
        }

        .pricing-period {
            color: #666;
            margin-bottom: 30px;
        }

        .pricing-features {
            list-style: none;
            padding: 0;
            margin: 30px 0;
        }

        .pricing-features li {
            padding: 12px 0;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .pricing-features li i {
            color: #28a745;
            width: 20px;
        }

        .pricing-features li.disabled {
            color: #ccc;
        }

        .pricing-features li.disabled i {
            color: #ccc;
        }

        .btn-pricing {
            display: block;
            padding: 15px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            text-align: center;
            text-decoration: none;
            border-radius: 40px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-pricing:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(102,126,234,0.3);
        }

        .btn-pricing.outline {
            background: transparent;
            border: 2px solid #667eea;
            color: #667eea;
        }

        .btn-pricing.outline:hover {
            background: #667eea;
            color: white;
        }

        /* FAQ Section */
        .faq-section {
            padding: 80px 0;
            background: white;
        }

        .faq-card {
            background: #f8f9fa;
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 20px;
        }

        .faq-card h4 {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 15px;
            color: #1e1e1e;
        }

        .faq-card p {
            color: #666;
            line-height: 1.8;
            margin: 0;
        }

        /* Guarantee Section */
        .guarantee-section {
            padding: 60px 0;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .guarantee-item {
            text-align: center;
            padding: 30px;
        }

        .guarantee-icon {
            width: 80px;
            height: 80px;
            background: rgba(255,255,255,0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            margin: 0 auto 20px;
        }

        .guarantee-item h4 {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .guarantee-item p {
            opacity: 0.9;
            margin: 0;
        }

        /* CTA Section */
        .cta-section {
            padding: 80px 0;
            background: white;
            text-align: center;
        }

        .cta-section h2 {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 20px;
            color: #1e1e1e;
        }

        .cta-section p {
            font-size: 18px;
            color: #666;
            margin-bottom: 30px;
        }

        .btn-cta {
            padding: 15px 40px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            text-decoration: none;
            border-radius: 40px;
            font-weight: 600;
            display: inline-block;
            transition: all 0.3s ease;
        }

        .btn-cta:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(102,126,234,0.3);
        }

        /* Footer */
        .site-footer {
            background: #1e1e1e;
            color: white;
            padding: 60px 0 30px;
        }

        .footer-widget {
            margin-bottom: 30px;
        }

        .footer-logo {
            max-width: 150px;
            margin-bottom: 20px;
        }

        .footer-widget p {
            color: rgba(255,255,255,0.7);
            line-height: 1.8;
            margin-bottom: 20px;
        }

        .footer-social {
            display: flex;
            gap: 15px;
        }

        .footer-social a {
            width: 40px;
            height: 40px;
            background: rgba(255,255,255,0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            transition: all 0.3s ease;
        }

        .footer-social a:hover {
            background: #667eea;
            transform: translateY(-3px);
        }

        .footer-widget h4 {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .footer-links {
            list-style: none;
            padding: 0;
        }

        .footer-links li {
            margin-bottom: 10px;
        }

        .footer-links a {
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .footer-links a:hover {
            color: white;
        }

        .footer-contact {
            list-style: none;
            padding: 0;
        }

        .footer-contact li {
            display: flex;
            align-items: center;
            gap: 10px;
            color: rgba(255,255,255,0.7);
            margin-bottom: 15px;
        }

        .footer-contact i {
            width: 30px;
            color: #667eea;
        }

        .footer-bottom {
            margin-top: 50px;
            padding-top: 30px;
            border-top: 1px solid rgba(255,255,255,0.1);
            text-align: center;
            color: rgba(255,255,255,0.5);
            font-size: 14px;
        }

        /* Mobile Menu */
        .mobile-menu {
            position: fixed;
            top: 0;
            left: -100%;
            width: 300px;
            height: 100vh;
            background: white;
            z-index: 10000;
            padding: 40px 20px;
            transition: left 0.4s ease;
            box-shadow: 2px 0 20px rgba(0,0,0,0.1);
        }

        .mobile-menu.open {
            left: 0;
        }

        .mobile-menu-close {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 24px;
            cursor: pointer;
            color: #333;
        }

        .mobile-menu-logo {
            margin-bottom: 40px;
        }

        .mobile-menu-logo img {
            max-width: 150px;
        }

        .mobile-menu-links {
            list-style: none;
            padding: 0;
        }

        .mobile-menu-links li {
            margin-bottom: 15px;
        }

        .mobile-menu-links a {
            color: #333;
            text-decoration: none;
            font-size: 16px;
            font-weight: 500;
            display: block;
            padding: 10px;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .mobile-menu-links a:hover {
            background: #f0f0f0;
            padding-left: 20px;
        }

        .mobile-menu-buttons {
            margin-top: 30px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .mobile-menu-buttons .btn-outline {
            border-color: #667eea;
            color: #667eea;
            text-align: center;
        }

        .mobile-menu-buttons .btn-solid {
            background: #667eea;
            color: white;
            text-align: center;
        }

        /* Responsive */
        @media (max-width: 991px) {
            .main-menu__list {
                display: none;
            }

            .header-buttons {
                display: none;
            }

            .mobile-nav__toggler {
                display: block;
            }

            .page-header h1 {
                font-size: 36px;
            }

            .pricing-card.featured {
                transform: scale(1);
            }

            .guarantee-item {
                margin-bottom: 30px;
            }
        }
    </style>
</head>

<body>
    <!-- Header -->
    <header class="main-header" id="mainHeader">
        <div class="container">
            <div class="main-menu-wrapper">
                <div class="main-menu-wrapper__logo">
                    <a href="/">
                        <img src="/assets/images/resources/care-logo-white.png" alt="Care System">
                    </a>
                </div>
                <div class="main-menu-wrapper__main-menu">
                    <ul class="main-menu__list">
                        <li><a href="/">Home</a></li>
                        <li><a href="/how-it-works">How It Works</a></li>
                        <li><a href="/features">Features</a></li>
                        <li><a href="/pricing" class="active">Pricing</a></li>
                        <li><a href="/about">About Us</a></li>
                        <li><a href="/contact">Contact</a></li>
                    </ul>
                </div>
                <div class="header-buttons">
                    <a href="/login" class="btn-outline">Login</a>
                    <a href="/register" class="btn-solid">Start Free Trial</a>
                </div>
                <a href="#" class="mobile-nav__toggler" id="mobileToggler">
                    <i class="fa fa-bars"></i>
                </a>
            </div>
        </div>
    </header>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
        <span class="mobile-menu-close" id="mobileClose"><i class="fa fa-times"></i></span>
        <div class="mobile-menu-logo">
            <img src="/assets/images/resources/care-logo.png" alt="Care System">
        </div>
        <ul class="mobile-menu-links">
            <li><a href="/">Home</a></li>
            <li><a href="/how-it-works">How It Works</a></li>
            <li><a href="/features">Features</a></li>
            <li><a href="/pricing">Pricing</a></li>
            <li><a href="/about">About Us</a></li>
            <li><a href="/contact">Contact</a></li>
        </ul>
        <div class="mobile-menu-buttons">
            <a href="/login" class="btn-outline">Login</a>
            <a href="/register" class="btn-solid">Start Free Trial</a>
        </div>
    </div>

    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <h1>Simple, Transparent Pricing</h1>
            <p>Choose the perfect plan for your care business. All plans include a 14-day free trial.</p>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Pricing</li>
                </ol>
            </nav>
        </div>
    </section>

    <!-- Pricing Section -->
    <section class="pricing-section">
        <div class="container">
            <!-- Pricing Toggle -->
            <div class="pricing-toggle">
                <span class="toggle-option active">Monthly</span>
                <div class="toggle-switch" id="pricingToggle"></div>
                <span class="toggle-option">Annual <span class="badge bg-success text-white ms-2">Save 20%</span></span>
            </div>

            <div class="row align-items-center">
                <!-- Essential Plan -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="pricing-card">
                        <div class="pricing-badge">ESSENTIAL</div>
                        <h3>Essential</h3>
                        <div class="pricing-price" id="essentialPrice">£49</div>
                        <div class="pricing-period" id="essentialPeriod">per month</div>
                        <p class="text-muted">Perfect for small agencies starting out</p>
                        <ul class="pricing-features">
                            <li><i class="fas fa-check"></i> Up to 5 support workers</li>
                            <li><i class="fas fa-check"></i> Up to 20 service users</li>
                            <li><i class="fas fa-check"></i> Basic scheduling</li>
                            <li><i class="fas fa-check"></i> Interaction logging</li>
                            <li><i class="fas fa-check"></i> Email support</li>
                            <li class="disabled"><i class="fas fa-times"></i> Medication management</li>
                            <li class="disabled"><i class="fas fa-times"></i> Guardian portal</li>
                        </ul>
                        <a href="/register" class="btn-pricing outline">Start Free Trial</a>
                    </div>
                </div>

                <!-- Professional Plan (Featured) -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="pricing-card featured">
                        <div class="pricing-badge">PROFESSIONAL</div>
                        <h3>Professional</h3>
                        <div class="pricing-price" id="professionalPrice">£99</div>
                        <div class="pricing-period" id="professionalPeriod">per month</div>
                        <p class="text-muted">For growing care businesses</p>
                        <ul class="pricing-features">
                            <li><i class="fas fa-check"></i> Up to 20 support workers</li>
                            <li><i class="fas fa-check"></i> Up to 100 service users</li>
                            <li><i class="fas fa-check"></i> Advanced scheduling</li>
                            <li><i class="fas fa-check"></i> Medication management</li>
                            <li><i class="fas fa-check"></i> Guardian portal</li>
                            <li><i class="fas fa-check"></i> Priority support</li>
                            <li class="disabled"><i class="fas fa-times"></i> Multi-location</li>
                        </ul>
                        <a href="/register" class="btn-pricing">Start Free Trial</a>
                    </div>
                </div>

                <!-- Enterprise Plan -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="pricing-card">
                        <div class="pricing-badge">ENTERPRISE</div>
                        <h3>Enterprise</h3>
                        <div class="pricing-price" id="enterprisePrice">£199</div>
                        <div class="pricing-period" id="enterprisePeriod">per month</div>
                        <p class="text-muted">For large care providers and groups</p>
                        <ul class="pricing-features">
                            <li><i class="fas fa-check"></i> Unlimited support workers</li>
                            <li><i class="fas fa-check"></i> Unlimited service users</li>
                            <li><i class="fas fa-check"></i> Multi-location support</li>
                            <li><i class="fas fa-check"></i> Advanced analytics</li>
                            <li><i class="fas fa-check"></i> API access</li>
                            <li><i class="fas fa-check"></i> Dedicated account manager</li>
                        </ul>
                        <a href="/contact" class="btn-pricing outline">Contact Sales</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Guarantee Section -->
    <section class="guarantee-section">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6">
                    <div class="guarantee-item">
                        <div class="guarantee-icon">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <h4>14-Day Free Trial</h4>
                        <p>Try all features risk-free. No credit card required.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="guarantee-item">
                        <div class="guarantee-icon">
                            <i class="fas fa-headset"></i>
                        </div>
                        <h4>Free Onboarding Support</h4>
                        <p>Get started with personalized setup assistance.</p>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="guarantee-item">
                        <div class="guarantee-icon">
                            <i class="fas fa-sync-alt"></i>
                        </div>
                        <h4>Cancel Anytime</h4>
                        <p>No long-term contracts. Cancel whenever you need.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section">
        <div class="container">
            <div class="section-title text-center mb-5">
                <span class="section-subtitle">FAQ</span>
                <h2>Frequently Asked Questions</h2>
                <p>Got questions about pricing? We've got answers.</p>
            </div>

            <div class="row">
                <div class="col-lg-6">
