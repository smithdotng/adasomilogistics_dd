    <!-- Custom Service Users Page Script -->
    <script>
        $(document).ready(function() {
            // Initialize WOW.js
            if ($('.wow').length) {
                new WOW().init();
            }
            
            // Auto-focus search input if search parameter exists
            <% if (typeof search !== 'undefined' && search) { %>
                $('input[name="search"]').focus().select();
            <% } %>
            
            // Add animation to table rows on hover
            $('table tbody tr').hover(
                function() {
                    $(this).css('transition', 'all 0.3s ease');
                },
                function() {
                    $(this).css('transition', 'all 0.3s ease');
                }
            );
            
            // Calculate age for service users without age field
            $('.age-badge').each(function() {
                const text = $(this).text();
                if (text === 'N/A' || text === '') {
                    // Try to calculate from date of birth if available in data attribute
                    const dob = $(this).data('dob');
                    if (dob) {
                        const birthDate = new Date(dob);
                        const today = new Date();
                        let age = today.getFullYear() - birthDate.getFullYear();
                        const monthDiff = today.getMonth() - birthDate.getMonth();
                        if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) {
                            age--;
                        }
                        $(this).text(age);
                    }
                }
            });
            
            // Handle filter form submission
            $('form').on('submit', function() {
                // Show loading state
                $('button[type="submit"]').html('<i class="fas fa-spinner fa-spin me-2"></i>Filtering...').prop('disabled', true);
            });
        });
    </script>
