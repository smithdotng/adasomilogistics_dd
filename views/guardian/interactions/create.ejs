<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log Interaction || Care System Guardian</title>
    
    <!-- favicons Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicons/favicon-16x16.png" />
    <link rel="manifest" href="/assets/images/favicons/site.webmanifest" />
    <meta name="description" content="Care System - Guardian Log Interaction" />

    <!-- fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <!-- CSS libraries -->
    <link rel="stylesheet" href="/assets/vendors/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/assets/vendors/animate/animate.min.css" />
    <link rel="stylesheet" href="/assets/vendors/animate/custom-animate.css" />
    <link rel="stylesheet" href="/assets/vendors/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="/assets/vendors/jarallax/jarallax.css" />
    <link rel="stylesheet" href="/assets/vendors/jquery-magnific-popup/jquery.magnific-popup.css" />
    <link rel="stylesheet" href="/assets/vendors/nouislider/nouislider.min.css" />
    <link rel="stylesheet" href="/assets/vendors/nouislider/nouislider.pips.css" />
    <link rel="stylesheet" href="/assets/vendors/odometer/odometer.min.css" />
    <link rel="stylesheet" href="/assets/vendors/swiper/swiper.min.css" />
    <link rel="stylesheet" href="/assets/vendors/sominx-icons/style.css">
    <link rel="stylesheet" href="/assets/vendors/tiny-slider/tiny-slider.min.css" />
    <link rel="stylesheet" href="/assets/vendors/reey-font/stylesheet.css" />
    <link rel="stylesheet" href="/assets/vendors/owl-carousel/owl.carousel.min.css" />
    <link rel="stylesheet" href="/assets/vendors/owl-carousel/owl.theme.default.min.css" />
    <link rel="stylesheet" href="/assets/vendors/twentytwenty/twentytwenty.css" />
    <link rel="stylesheet" href="/assets/vendors/bxslider/jquery.bxslider.css" />
    <link rel="stylesheet" href="/assets/vendors/bootstrap-select/css/bootstrap-select.min.css" />
    <link rel="stylesheet" href="/assets/vendors/vegas/vegas.min.css" />
    <link rel="stylesheet" href="/assets/vendors/jquery-ui/jquery-ui.css" />
    <link rel="stylesheet" href="/assets/vendors/timepicker/timePicker.css" />

    <!-- template styles -->
    <link rel="stylesheet" href="/assets/css/sominx.css" />
    <link rel="stylesheet" href="/assets/css/sominx-responsive.css" />
    
    <!-- Guardian Interaction Styles -->
    <style>
        :root {
            --guardian-primary: #4a8b8f;
            --guardian-secondary: #f5a623;
            --guardian-accent: #7b68ee;
        }
        
        .interactions-header {
            background: #fff;
            border-radius: 10px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0px 10px 60px 0px rgba(0, 0, 0, 0.07);
        }
        
        .interaction-form-card {
            background: #fff;
            border-radius: 10px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0px 10px 60px 0px rgba(0, 0, 0, 0.07);
        }
        
        .form-control, .form-select, .form-textarea {
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 12px 15px;
        }
        
        .form-control:focus, .form-select:focus, .form-textarea:focus {
            border-color: var(--guardian-primary);
            box-shadow: 0 0 0 0.2rem rgba(74, 139, 143, 0.25);
        }
        
        .form-textarea {
            min-height: 120px;
            resize: vertical;
        }
        
        .thm-btn {
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .form-label {
            font-weight: 600;
            color: #213360;
            margin-bottom: 8px;
        }
        
        .required:after {
            content: " *";
            color: #dc3545;
        }
        
        .type-option {
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-bottom: 10px;
        }
        
        .type-option:hover {
            border-color: var(--guardian-primary);
            background: rgba(74, 139, 143, 0.05);
        }
        
        .type-option.active {
            border-color: var(--guardian-primary);
            background: rgba(74, 139, 143, 0.1);
        }
        
        .type-icon {
            font-size: 24px;
            margin-bottom: 10px;
            display: block;
        }
        
        .file-preview {
            border: 1px dashed #dee2e6;
            border-radius: 8px;
            padding: 20px;
            text-align: center;
            background: #f8f9fa;
        }
        
        .file-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px;
            background: white;
            border: 1px solid #e9ecef;
            border-radius: 6px;
            margin-bottom: 8px;
        }
        
        .file-name {
            flex: 1;
            margin: 0 10px;
            font-size: 14px;
        }
        
        .form-section {
            border-top: 2px solid #f0f0f0;
            padding-top: 30px;
            margin-top: 30px;
        }
        
        .form-section-title {
            font-size: 1.2rem;
            font-weight: 600;
            color: #213360;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--guardian-primary);
        }
        
        .duration-inputs {
            display: flex;
            gap: 10px;
            align-items: center;
        }
        
        .duration-input {
            flex: 1;
        }
        
        .duration-label {
            font-size: 12px;
            color: #6c757d;
            margin-top: 5px;
            text-align: center;
        }
        
        .alert-warning {
            background: rgba(255, 193, 7, 0.1);
            border: 1px solid rgba(255, 193, 7, 0.2);
            border-radius: 8px;
            padding: 15px;
        }
        
        .service-user-info-box {
            background: rgba(74, 139, 143, 0.05);
            border: 1px solid rgba(74, 139, 143, 0.2);
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
        }
        
        .service-user-info-box h5 {
            color: var(--guardian-primary);
            margin-bottom: 10px;
        }
        
        .btn-add {
            background: #28a745;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 8px 20px;
            font-size: 14px;
        }
        
        .btn-add:hover {
            background: #218838;
        }
        
        .task-item, .medication-item {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 10px;
        }
        
        .remove-btn {
            background: #dc3545;
            color: white;
            border: none;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            cursor: pointer;
        }
        
        .remove-btn:hover {
            background: #c82333;
        }
        
        .type-family_meeting { color: #6f42c1; }
        .type-phone_call { color: #28a745; }
        .type-visit { color: #17a2b8; }
        .type-emergency { color: #dc3545; }
        .type-email { color: #fd7e14; }
        .type-other { color: #6c757d; }
    </style>
</head>

<body>
    <div class="preloader">
        <img class="preloader__image" width="60" src="/assets/images/loader.png" alt="" />
    </div>
    <!-- /.preloader -->
    
    <div class="page-wrapper">
        <!-- Header Start -->
        <header class="main-header clearfix">
            <nav class="main-menu clearfix">
                <div class="main-menu-wrapper clearfix">
                    <div class="main-menu-wrapper-inner clearfix">
                        <div class="main-menu-wrapper__left clearfix">
                            <div class="main-menu-wrapper__logo">
                                <a href="/"><img src="/assets/images/resources/logo-1.jpg" alt="Care System"></a>
                            </div>
                            <div class="main-menu-wrapper__main-menu">
                                <a href="#" class="mobile-nav__toggler"><i class="fa fa-bars"></i></a>
                                <ul class="main-menu__list">
                                    <li><a href="/guardian/dashboard">Dashboard</a></li>
                                    <li><a href="/guardian/service-user">Service User Information</a></li>
                                    <li class="current"><a href="/guardian/interactions">Interactions</a></li>
                                    <li><a href="/guardian/documents">Documents</a></li>
                                    <li><a href="/guardian/change-password">Settings</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="main-menu-wrapper__right">
                            <div class="main-menu-wrapper__call">
                                <div class="main-menu-wrapper__call-icon">
                                    <span class="icon-user-check"></span>
                                </div>
                                <div class="main-menu-wrapper__call-number">
                                    <p>Welcome back</p>
                                    <a href="/guardian/change-password"><%= user.fullName %></a>
                                </div>
                            </div>
                            <div class="main-menu-wrapper__search-box">
                                <a href="/logout" class="main-menu-wrapper__logout" title="Logout">
                                    <i class="fas fa-sign-out-alt"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
        <!-- Header End -->

        <div class="stricky-header stricked-menu main-menu">
            <div class="sticky-header__content"></div>
        </div>

        <!--Page Header Start-->
        <section class="page-header" style="padding: 60px 0 40px;">
            <div class="container">
                <div class="page-header__inner">
                    <h2>Log New Interaction</h2>
                </div>
            </div>
        </section>
        <!--Page Header End-->

        <!-- Create Interaction Content Start -->
        <section class="interactions-content pt-80 pb-120">
            <div class="container">
                <div class="interactions-header wow fadeInUp" data-wow-delay="100ms">
                    <div class="row align-items-center">
                        <div class="col-lg-8">
                            <h3 class="mb-3">
                                <i class="fas fa-plus-circle text-primary me-2"></i>
                                Log Interaction for <%= serviceUser.firstName %> <%= serviceUser.lastName %>
                            </h3>
                            <p class="text-muted mb-0">Record details of your interaction with <%= serviceUser.firstName %>. All fields marked with * are required.</p>
                        </div>
                        <div class="col-lg-4 text-lg-end">
                            <a href="/guardian/interactions" class="thm-btn" style="background: #6c757d;">
                                <i class="fas fa-arrow-left me-2"></i>Back to Interactions
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Flash Messages -->
                <% if (typeof messages !== 'undefined' && messages.error && messages.error.length > 0) { %>
                    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                        <%= messages.error %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>
                
                <% if (typeof messages !== 'undefined' && messages.success && messages.success.length > 0) { %>
                    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                        <%= messages.success %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                <% } %>

                <div class="interaction-form-card wow fadeInUp" data-wow-delay="200ms">
                    <form action="/guardian/interactions" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>
                        <!-- Service User Information -->
                        <div class="service-user-info-box">
                            <h5><i class="fas fa-user me-2"></i>Service User Information</h5>
                            <div class="row">
                                <div class="col-md-6">
                                    <p class="mb-1"><strong>Name:</strong> <%= serviceUser.firstName %> <%= serviceUser.lastName %></p>
                                    <p class="mb-1"><strong>Age:</strong> <%= serviceUser.age %></p>
                                </div>
                                <div class="col-md-6">
                                    <p class="mb-1"><strong>Status:</strong> 
                                        <span class="badge bg-<%= serviceUser.status === 'active' ? 'success' : 'warning' %>">
                                            <%= serviceUser.status %>
                                        </span>
                                    </p>
                                    <p class="mb-0"><strong>Care Level:</strong> <%= serviceUser.careInfo.careLevel %></p>
                                </div>
                            </div>
                            <input type="hidden" name="service user" value="<%= serviceUser._id %>">
                            <input type="hidden" name="support worker" value="<%= user.id %>">
                        </div>

                        <!-- Basic Information Section -->
                        <div class="mb-5">
                            <h4 class="form-section-title">
                                <i class="fas fa-info-circle me-2"></i>Basic Information
                            </h4>
                            
                            <div class="row">
                                <div class="col-md-8 mb-4">
                                    <label for="title" class="form-label required">Interaction Title</label>
                                    <input type="text" class="form-control" id="title" name="title" 
                                           placeholder="e.g., Weekly Check-in, Family Discussion, Emergency Response" required>
                                    <div class="invalid-feedback">
                                        Please provide a title for this interaction.
                                    </div>
                                </div>
                                
                                <div class="col-12 mb-4">
                                    <label class="form-label required">Interaction Type</label>
                                    <div class="row" id="typeSelection">
                                        <div class="col-md-2 col-sm-4 col-6">
                                            <div class="type-option" data-type="family_meeting">
                                                <i class="fas fa-users type-icon type-family_meeting"></i>
                                                <div class="type-name">Family Meeting</div>
                                            </div>
                                            <input type="radio" name="type" value="family_meeting" class="d-none" checked required>
                                        </div>
                                        <div class="col-md-2 col-sm-4 col-6">
                                            <div class="type-option" data-type="phone_call">
                                                <i class="fas fa-phone type-icon type-phone_call"></i>
                                                <div class="type-name">Phone Call</div>
                                            </div>
                                            <input type="radio" name="type" value="phone_call" class="d-none">
                                        </div>
                                        <div class="col-md-2 col-sm-4 col-6">
                                            <div class="type-option" data-type="visit">
                                                <i class="fas fa-home type-icon type-visit"></i>
                                                <div class="type-name">Visit</div>
                                            </div>
                                            <input type="radio" name="type" value="visit" class="d-none">
                                        </div>
                                        <div class="col-md-2 col-sm-4 col-6">
                                            <div class="type-option" data-type="emergency">
                                                <i class="fas fa-exclamation-triangle type-icon type-emergency"></i>
                                                <div class="type-name">Emergency</div>
                                            </div>
                                            <input type="radio" name="type" value="emergency" class="d-none">
                                        </div>
                                        <div class="col-md-2 col-sm-4 col-6">
                                            <div class="type-option" data-type="email">
                                                <i class="fas fa-envelope type-icon type-email"></i>
                                                <div class="type-name">Email</div>
                                            </div>
                                            <input type="radio" name="type" value="email" class="d-none">
                                        </div>
                                        <div class="col-md-2 col-sm-4 col-6">
                                            <div class="type-option" data-type="other">
                                                <i class="fas fa-clipboard type-icon type-other"></i>
                                                <div class="type-name">Other</div>
                                            </div>
                                            <input type="radio" name="type" value="other" class="d-none">
                                        </div>
                                    </div>
                                    <div class="invalid-feedback d-none" id="typeError">
                                        Please select an interaction type.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Time & Location Section -->
                        <div class="form-section">
                            <h4 class="form-section-title">
                                <i class="fas fa-clock me-2"></i>Time & Location
                            </h4>
                            
                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <label for="startTime" class="form-label required">Start Date & Time</label>
                                    <input type="datetime-local" class="form-control" id="startTime" name="startTime" required>
                                    <div class="invalid-feedback">
                                        Please select a start date and time.
                                    </div>
                                </div>
                                
                                <div class="col-md-6 mb-4">
                                    <label for="endTime" class="form-label">End Date & Time</label>
                                    <input type="datetime-local" class="form-control" id="endTime" name="endTime">
                                    <div class="form-text">Leave blank if interaction is ongoing</div>
                                </div>
                                
                                <div class="col-md-6 mb-4">
                                    <label for="location" class="form-label">Location</label>
                                    <select class="form-select" id="location" name="location">
                                        <option value="client_home">Service User's Home</option>
                                        <option value="office">Office</option>
                                        <option value="hospital">Hospital</option>
                                        <option value="community">Community</option>
                                        <option value="other">Other</option>
                                    </select>
                                </div>
                                
                                <div class="col-md-6 mb-4">
                                    <label class="form-label required">Status</label>
                                    <select class="form-select" name="status" required>
                                        <option value="draft">Draft</option>
                                        <option value="completed" selected>Completed</option>
                                        <option value="cancelled">Cancelled</option>
                                    </select>
                                    <div class="invalid-feedback">
                                        Please select a status.
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Description Section -->
                        <div class="form-section">
                            <h4 class="form-section-title">
                                <i class="fas fa-file-alt me-2"></i>Interaction Details
                            </h4>
                            
                            <div class="mb-4">
                                <label for="description" class="form-label required">Description / Notes</label>
                                <textarea class="form-control form-textarea" id="description" name="description" 
                                          placeholder="Describe what happened during the interaction, any observations, concerns, or important information..." 
                                          rows="6" required></textarea>
                                <div class="invalid-feedback">
                                    Please provide a description of the interaction.
                                </div>
                                <div class="form-text">Be as detailed as possible. This helps the care team understand the situation.</div>
                            </div>
                            
                            <!-- Service User Observations -->
                            <div class="mb-4">
                                <label for="observations" class="form-label">Service User Observations</label>
                                <textarea class="form-control form-textarea" id="observations" name="observations.notes" 
                                          placeholder="Note service user's mood, behavior, physical condition, or any changes you observed..." 
                                          rows="4"></textarea>
                                <div class="form-text">Optional: Document any changes in service user's condition or behavior</div>
                            </div>
                            
                            <!-- Follow-up Actions -->
                            <div class="mb-4">
                                <label for="followUp" class="form-label">Follow-up Actions Needed</label>
                                <textarea class="form-control form-textarea" id="followUp" name="followUp" 
                                          placeholder="List any actions that need to be taken, who should take them, and deadlines..." 
                                          rows="4"></textarea>
                                <div class="form-text">Optional: Note any follow-up required by care team or yourself</div>
                            </div>
                        </div>

                        <!-- Attachments Section -->
                        <div class="form-section">
                            <h4 class="form-section-title">
                                <i class="fas fa-paperclip me-2"></i>Attachments
                            </h4>
                            
                            <div class="alert alert-warning mb-4">
                                <i class="fas fa-info-circle me-2"></i>
                                Allowed file types: JPG, PNG, PDF, DOC, DOCX. Maximum file size: 5MB each. Maximum 5 files.
                            </div>
                            
                            <div class="mb-4">
                                <label for="attachments" class="form-label">Upload Files</label>
                                <input type="file" class="form-control" id="attachments" name="attachments" 
                                       accept=".jpg,.jpeg,.png,.pdf,.doc,.docx" multiple>
                                <div class="form-text">Upload photos, documents, or reports related to this interaction</div>
                            </div>
                            
                            <div id="filePreview" class="file-preview d-none">
                                <i class="fas fa-cloud-upload-alt fa-3x text-muted mb-3"></i>
                                <p class="text-muted mb-0">Selected files will appear here</p>
                            </div>
                        </div>

                        <!-- Verification Section -->
                        <div class="form-section">
                            <h4 class="form-section-title">
                                <i class="fas fa-check-circle me-2"></i>Verification
                            </h4>
                            
                            <div class="form-check mb-4">
                                <input class="form-check-input" type="checkbox" id="verifiedByGuardian" name="verifiedByGuardian" value="true" checked>
                                <label class="form-check-label" for="verifiedByGuardian">
                                    <strong>I verify that this interaction record is accurate and complete</strong>
                                </label>
                                <div class="form-text">
                                    As the guardian of <%= serviceUser.firstName %> <%= serviceUser.lastName %>, I confirm this interaction took place as described.
                                </div>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div class="d-flex justify-content-between align-items-center mt-5 pt-4 border-top">
                            <a href="/guardian/interactions" class="btn btn-lg btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-lg btn-primary" style="background: var(--guardian-primary); border-color: var(--guardian-primary);">
                                <i class="fas fa-save me-2"></i>Log Interaction
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </section>
        <!-- Create Interaction Content End -->

        <!--Footer Start-->
        <footer class="site-footer">
            <div class="site-footer-bg" style="background-image: url(/assets/images/backgrounds/site-footer-bg.jpg)"></div>
            <div class="site-footer-bg-overly"></div>
            <div class="container">
                <div class="site-footer__top">
                    <div class="row">
                        <div class="col-xl-4 col-lg-2">
                            <div class="site-footer__top-logo">
                                <a href="/"><img src="/assets/images/resources/footer-logo-1.jpg" alt="Care System"></a>
                            </div>
                        </div>
                        <div class="col-xl-8 col-lg-10">
                            <div class="site-footer__top-right">
                                <div class="site-footer__call-and-social">
                                    <div class="site-footer__call">
                                        <p>Guardian Portal <a href="tel:<%= serviceUser.contact.emergencyContact.phone || '123-456-7890' %>">Emergency: <%= serviceUser.contact.emergencyContact.phone || '123-456-7890' %></a></p>
                                    </div>
                                    <div class="site-footer__social">
                                        <a href="/guardian/dashboard" title="Dashboard"><i class="fas fa-tachometer-alt"></i></a>
                                        <a href="/guardian/service-user" title="Service User Info"><i class="fas fa-user"></i></a>
                                        <a href="/guardian/interactions" title="Interactions"><i class="fas fa-history"></i></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="site-footer__bottom">
                    <div class="row">
                        <div class="col-xl-4 col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="100ms">
                            <div class="footer-widget__column footer-widget__contact">
                                <h3 class="footer-widget__title">Contact Care Team</h3>
                                <p class="footer-widget__contact-text">
                                    <% if (serviceUser.assignedSupportWorker) { %>
