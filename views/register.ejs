    <!-- JavaScript -->
    <script src="/assets/vendors/jquery/jquery-3.6.0.min.js"></script>
    <script src="/assets/vendors/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/vendors/bootstrap-select/js/bootstrap-select.min.js"></script>

    <script>
        $(document).ready(function() {
            console.log('jQuery ready - register page');
            
            let currentStep = 1;
            const totalSteps = 4;
            let validationErrors = [];

            // Real-time validation for website field
            $('#website').on('input', function() {
                const value = $(this).val().trim();
                const errorElement = $('#websiteError');
                
                if (value === '') {
                    // Empty is fine (optional field)
                    $(this).removeClass('error valid');
                    errorElement.removeClass('show');
                } else {
                    // Validate website format (more forgiving)
                    if (isValidWebsite(value)) {
                        $(this).removeClass('error').addClass('valid');
                        errorElement.removeClass('show');
                    } else {
                        $(this).removeClass('valid').addClass('error');
                        errorElement.addClass('show');
                    }
                }
            });

            // Website validation function - more forgiving
            function isValidWebsite(url) {
                if (!url || url.trim() === '') return true; // Empty is valid (optional)
                
                // Remove common prefixes if present for validation
                let testUrl = url.trim().toLowerCase();
                
                // Basic domain validation
                const domainPattern = /^([a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,}$/;
                const urlWithProtocolPattern = /^https?:\/\/[^\s]+$/;
                
                // Check if it's a valid domain (e.g., shedfactory.co)
                if (domainPattern.test(testUrl)) {
                    return true;
                }
                
                // Check if it's a valid URL with protocol (e.g., https://shedfactory.co)
                if (urlWithProtocolPattern.test(testUrl)) {
                    return true;
                }
                
                // Check if it's a valid domain with www but no protocol
                if (testUrl.startsWith('www.')) {
                    const domain = testUrl.substring(4);
                    return domainPattern.test(domain);
                }
                
                return false;
            }

            // Format website URL before submission
            function formatWebsite(url) {
                if (!url || url.trim() === '') return '';
                
                let formatted = url.trim();
                
                // If it's a valid domain without protocol, add https://
                const domainPattern = /^([a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,}$/;
                if (domainPattern.test(formatted)) {
                    formatted = 'https://' + formatted;
                }
                
                // If it starts with www but no protocol, add https://
                if (formatted.startsWith('www.')) {
                    formatted = 'https://' + formatted;
                }
                
                return formatted;
            }

            // Validate section function with better error handling
            window.validateSection = function(section) {
                console.log('Validating section:', section);
                validationErrors = [];
                
                // Clear all previous error highlights
                $('.form-control').removeClass('error');
                $('.error-message').removeClass('show');
                $('#validationSummary').removeClass('show');
                $('#errorList').empty();
                
                switch(section) {
                    case 1:
                        // First Name
                        const firstName = $('#firstName').val().trim();
                        if (!firstName) {
                            validationErrors.push('First name is required');
                            $('#firstName').addClass('error');
                            $('#firstNameError').addClass('show');
                        }

                        // Last Name
                        const lastName = $('#lastName').val().trim();
                        if (!lastName) {
                            validationErrors.push('Last name is required');
                            $('#lastName').addClass('error');
                            $('#lastNameError').addClass('show');
                        }

                        // Email
                        const email = $('#email').val().trim();
                        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                        if (!email) {
                            validationErrors.push('Email is required');
                            $('#email').addClass('error');
                            $('#emailError').text('Email is required').addClass('show');
                        } else if (!emailPattern.test(email)) {
                            validationErrors.push('Please enter a valid email address');
                            $('#email').addClass('error');
                            $('#emailError').text('Please enter a valid email address').addClass('show');
                        }

                        // Password
                        const password = $('#password').val();
                        if (!password) {
                            validationErrors.push('Password is required');
                            $('#password').addClass('error');
                            $('#passwordError').text('Password is required').addClass('show');
                        } else if (password.length < 8) {
                            validationErrors.push('Password must be at least 8 characters long');
                            $('#password').addClass('error');
                            $('#passwordError').text('Password must be at least 8 characters').addClass('show');
                        }

                        // Confirm Password
                        const confirmPassword = $('#confirmPassword').val();
                        if (password !== confirmPassword) {
                            validationErrors.push('Passwords do not match');
                            $('#confirmPassword').addClass('error');
                            $('#confirmPasswordError').addClass('show');
                        }

                        // Phone
                        const phone = $('#phone').val().trim();
                        if (!phone) {
                            validationErrors.push('Phone number is required');
                            $('#phone').addClass('error');
                            $('#phoneError').text('Phone number is required').addClass('show');
                        } else if (!phone.match(/^[0-9\s\-\(\)]+$/)) {
                            validationErrors.push('Please enter a valid phone number');
                            $('#phone').addClass('error');
                            $('#phoneError').text('Please enter a valid phone number').addClass('show');
                        }
                        break;

                    case 2:
                        // Company Name
                        const companyName = $('#companyName').val().trim();
                        if (!companyName) {
                            validationErrors.push('Company name is required');
                            $('#companyName').addClass('error');
                            $('#companyNameError').addClass('show');
                        }

                        // Company Registration Number
                        const companyRegNumber = $('#companyRegNumber').val().trim();
                        if (!companyRegNumber) {
                            validationErrors.push('Company registration number is required');
                            $('#companyRegNumber').addClass('error');
                            $('#companyRegNumberError').addClass('show');
                        }

                        // Website (optional but validate if provided)
                        const website = $('#website').val().trim();
                        if (website && !isValidWebsite(website)) {
                            validationErrors.push('Please enter a valid website address (e.g., shedfactory.co or https://shedfactory.co)');
                            $('#website').addClass('error');
                            $('#websiteError').addClass('show');
                        }

                        // Address fields
                        const addressStreet = $('#addressStreet').val().trim();
                        if (!addressStreet) {
                            validationErrors.push('Street address is required');
                            $('#addressStreet').addClass('error');
                            $('#addressStreetError').addClass('show');
                        }

                        const addressCity = $('#addressCity').val().trim();
                        if (!addressCity) {
                            validationErrors.push('City is required');
                            $('#addressCity').addClass('error');
                            $('#addressCityError').addClass('show');
                        }

                        const addressPostcode = $('#addressPostcode').val().trim();
                        if (!addressPostcode) {
                            validationErrors.push('Postcode is required');
                            $('#addressPostcode').addClass('error');
                            $('#addressPostcodeError').addClass('show');
                        }
                        break;

                    case 3:
                        // CQC Location ID if CQC registered
                        if ($('#cqcYes').is(':checked')) {
                            const cqcLocationId = $('#cqcLocationId').val().trim();
                            if (!cqcLocationId) {
                                validationErrors.push('CQC Location ID is required if you are CQC registered');
                                $('#cqcLocationId').addClass('error');
                                $('#cqcLocationIdError').addClass('show');
                            }
                        }

                        // Data Protection confirmation
                        if (!$('#dataProtection').is(':checked')) {
                            validationErrors.push('You must confirm your ICO registration');
                            $('#dataProtectionError').addClass('show');
                        }
                        break;

                    case 4:
                        // Terms acceptance
                        if (!$('#termsAccepted').is(':checked')) {
                            validationErrors.push('You must accept the Terms and Conditions');
                            $('#termsError').addClass('show');
                        }
                        break;
                }

                // Show validation summary if there are errors
                if (validationErrors.length > 0) {
                    $('#validationSummary').addClass('show');
                    validationErrors.forEach(error => {
                        $('#errorList').append(`<li>${error}</li>`);
                    });
                    
                    // Scroll to top to show errors
                    $('html, body').animate({
                        scrollTop: $('.registration-body').offset().top - 100
                    }, 500);
                    
                    return false;
                }

                return true;
            }

            // Update steps function
            function updateSteps() {
                console.log('Updating steps to currentStep:', currentStep);
                
                // Update step indicators
                $('.step').removeClass('active completed');
                for (let i = 1; i <= totalSteps; i++) {
                    if (i === currentStep) {
                        $(`.step[data-step="${i}"]`).addClass('active');
                    } else if (i < currentStep) {
                        $(`.step[data-step="${i}"]`).addClass('completed');
                    }
                }

                // Show/hide sections
                $(`.form-section`).removeClass('active');
                $(`#section${currentStep}`).addClass('active');

                // Show/hide buttons
                if (currentStep === 1) {
                    $('#prevBtn').hide();
                } else {
                    $('#prevBtn').show();
                }

                if (currentStep === totalSteps) {
                    $('#nextBtn').hide();
                    $('#submitBtn').show();
                } else {
                    $('#nextBtn').show();
                    $('#submitBtn').hide();
                }
                
                // Hide validation summary when moving between steps
                $('#validationSummary').removeClass('show');
            }

            // Next button click
            $('#nextBtn').click(function() {
                console.log('Next button clicked, current step:', currentStep);
                
                if (validateSection(currentStep)) {
                    currentStep++;
                    updateSteps();
                    console.log('Moving to step:', currentStep);
                } else {
                    console.log('Validation failed for step:', currentStep);
                }
            });

            // Previous button click
            $('#prevBtn').click(function() {
                console.log('Previous button clicked');
                currentStep--;
                updateSteps();
            });

            // Form submission
            $('#registrationForm').submit(function(e) {
                console.log('Form submission triggered');
                
                // Validate final section
                if (!validateSection(4)) {
                    console.log('Final validation failed');
                    e.preventDefault();
                    return false;
                }
                
                // Format website URL before submission
                const websiteField = $('#website');
                if (websiteField.val().trim()) {
                    websiteField.val(formatWebsite(websiteField.val().trim()));
                }
                
                console.log('Form is valid, submitting...');
                return true; // Allow form to submit
            });

            // Password strength checker
            $('#password').on('input', function() {
                const password = $(this).val();
                const strength = calculatePasswordStrength(password);
                const strengthBar = $('#passwordStrength');
                const strengthText = $('#passwordStrengthText');

                if (strength === 0) {
                    strengthBar.css({ width: '0%', background: '#f0f0f0' });
                    strengthText.text('Enter a password');
                } else if (strength < 30) {
                    strengthBar.css({ width: '25%', background: '#dc3545' });
                    strengthText.text('Weak password');
                } else if (strength < 50) {
                    strengthBar.css({ width: '50%', background: '#ffc107' });
                    strengthText.text('Fair password');
                } else if (strength < 75) {
                    strengthBar.css({ width: '75%', background: '#17a2b8' });
                    strengthText.text('Good password');
                } else {
                    strengthBar.css({ width: '100%', background: '#28a745' });
                    strengthText.text('Strong password');
                }
            });

            function calculatePasswordStrength(password) {
                let strength = 0;
                
                if (password.length >= 8) strength += 25;
                if (password.match(/[a-z]+/)) strength += 25;
                if (password.match(/[A-Z]+/)) strength += 25;
                if (password.match(/[0-9]+/)) strength += 15;
                if (password.match(/[$@#&!]+/)) strength += 10;
                
                return Math.min(strength, 100);
            }

            // Password match checker
            $('#confirmPassword').on('input', function() {
                const password = $('#password').val();
                const confirm = $(this).val();
                const matchText = $('#passwordMatch');

                if (confirm.length === 0) {
                    matchText.text('');
                    $('#confirmPassword').removeClass('error valid');
                } else if (password === confirm) {
                    matchText.html('<span style="color: #28a745;"><i class="fas fa-check-circle"></i> Passwords match</span>');
                    $('#confirmPassword').removeClass('error').addClass('valid');
                } else {
                    matchText.html('<span style="color: #dc3545;"><i class="fas fa-exclamation-circle"></i> Passwords do not match</span>');
                    $('#confirmPassword').removeClass('valid').addClass('error');
                }
            });

            // CQC fields toggle
            function toggleCqcFields() {
                if ($('#cqcYes').is(':checked')) {
                    $('#cqcFields input').prop('disabled', false);
                    $('#cqcFields select').prop('disabled', false);
                } else {
                    $('#cqcFields input').prop('disabled', true);
                    $('#cqcFields select').prop('disabled', true);
                }
            }

            $('#cqcYes, #cqcNo').change(toggleCqcFields);
            toggleCqcFields();

            // File upload display
            $('#cqcCertificate').change(function() {
                const fileName = $(this).val().split('\\').pop();
                if (fileName) {
                    $('#fileName').text(fileName);
                } else {
                    $('#fileName').text('Click to upload or drag and drop');
                }
            });

            // Auto-hide flash messages
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);

            // Real-time validation for other fields (optional)
            $('input[required]').on('blur', function() {
                const field = $(this);
                if (field.val().trim() === '') {
                    field.addClass('error');
                } else {
                    field.removeClass('error').addClass('valid');
                }
            });
        });
    </script>
</body>
