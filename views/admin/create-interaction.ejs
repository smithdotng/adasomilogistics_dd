    <!-- Admin Create Interaction Script -->
    <script>
        $(document).ready(function() {
            // Initialize WOW.js
            if ($('.wow').length) {
                new WOW().init();
            }
            
            // Set default dates
            const now = new Date();
            const timezoneOffset = now.getTimezoneOffset() * 60000;
            const localISOTime = new Date(now - timezoneOffset).toISOString().slice(0, 16);
            
            // Set start time to now
            $('#startTime').val(localISOTime);
            
            // Set end time to 1 hour from now
            const endTime = new Date(now.getTime() + (60 * 60 * 1000));
            const endISOTime = new Date(endTime - timezoneOffset).toISOString().slice(0, 16);
            $('#endTime').val(endISOTime);
            
            // Type selection
            $('#typeSelection .interaction-type-option').click(function() {
                const type = $(this).data('type');
                
                // Remove active class from all options
                $('#typeSelection .interaction-type-option').removeClass('active');
                
                // Add active class to clicked option
                $(this).addClass('active');
                
                // Set the corresponding radio button as checked
                $(this).siblings('input[type="radio"]').prop('checked', true).trigger('change');
                
                // Hide error message
                $('#typeError').addClass('d-none');
            });
            
            // Set default active type (family_meeting)
            $('.interaction-type-option[data-type="family_meeting"]').addClass('active');
            
            // Auto-update end time when start time changes
            $('#startTime').on('change', function() {
                const startTime = new Date($(this).val());
                if (startTime && !isNaN(startTime.getTime())) {
                    const endTime = new Date(startTime.getTime() + (60 * 60 * 1000)); // +1 hour
                    const endISOTime = new Date(endTime - timezoneOffset).toISOString().slice(0, 16);
                    $('#endTime').val(endISOTime);
                }
            });
            
            // Save as draft button
            $('#saveDraft').on('click', function() {
                $('#status').val('draft');
                $('#createInteractionForm').submit();
            });
            
            // Form validation
            $('#createInteractionForm').on('submit', function(event) {
                // Check if type is selected
                const typeSelected = $('input[name="type"]:checked').length > 0;
                if (!typeSelected) {
                    $('#typeError').removeClass('d-none').show();
                    event.preventDefault();
                    event.stopPropagation();
                    return false;
                } else {
                    $('#typeError').addClass('d-none').hide();
                }
                
                // Check all required fields
                let isValid = true;
                $(this).find('[required]').each(function() {
                    if (!$(this).val()) {
                        $(this).addClass('error-field');
                        isValid = false;
                    } else {
                        $(this).removeClass('error-field');
                    }
                });
                
                if (!isValid) {
                    event.preventDefault();
                    event.stopPropagation();
                    alert('Please fill in all required fields marked with *');
                    return false;
                }
                
                // Validate end time is after start time
                const startTime = new Date($('#startTime').val());
                const endTime = $('#endTime').val() ? new Date($('#endTime').val()) : null;
                
                if (endTime && endTime <= startTime) {
                    event.preventDefault();
                    alert('End time must be after start time');
                    return false;
                }
                
                // If validation passes, show loading state
                const submitBtn = $(this).find('button[type="submit"]');
                const originalText = submitBtn.html();
                submitBtn.html('<i class="fas fa-spinner fa-spin me-2"></i>Creating...').prop('disabled', true);
                
                // Re-enable button after 10 seconds in case of error
                setTimeout(() => {
                    submitBtn.html(originalText).prop('disabled', false);
                }, 10000);
                
                return true;
            });
            
            // Remove error class when user starts typing
            $('input, textarea, select').on('input change', function() {
                if ($(this).val()) {
                    $(this).removeClass('error-field');
                }
            });
            
            // Client and operator search enhancement
            $('#client, #operator').select2({
                theme: 'bootstrap-5',
                placeholder: $(this).data('placeholder'),
                allowClear: true,
                width: '100%'
            });
            
            // Initialize tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();
        });
    </script>
