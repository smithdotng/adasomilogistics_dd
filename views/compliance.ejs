<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <meta name="description" content="How CareShed supports CQC compliance for UK care providers." />

    <!-- favicons Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicons/favicon-16x16.png" />
    <link rel="manifest" href="/assets/images/favicons/site.webmanifest" />

    <!-- fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet">

    <!-- CSS Links -->
    <link rel="stylesheet" href="/assets/vendors/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/assets/vendors/animate/animate.min.css" />
    <link rel="stylesheet" href="/assets/vendors/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="/assets/vendors/sominx-icons/style.css">

    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Jost', sans-serif; color: #1e1e1e; overflow-x: hidden; }

        /* Header */
        .main-header { position: fixed; top: 0; left: 0; width: 100%; background: transparent; padding: 20px 0; z-index: 1000; transition: all 0.4s ease; }
        .main-header.scrolled { background: white; box-shadow: 0 2px 20px rgba(0,0,0,0.1); padding: 10px 0; }
        .main-header.scrolled .main-menu__list > li > a { color: #333; }
        .main-header.scrolled .btn-outline { border-color: #667eea; color: #667eea; }
        .main-header.scrolled .btn-outline:hover { background: #667eea; color: white; }
        .main-menu-wrapper { display: flex; justify-content: space-between; align-items: center; }
        .main-menu-wrapper__logo img { height: 40px; transition: all 0.3s ease; }
        .main-header.scrolled .main-menu-wrapper__logo img { filter: brightness(0.2); }
        .main-menu__list { display: flex; list-style: none; margin: 0; padding: 0; gap: 30px; }
        .main-menu__list > li > a { color: white; text-decoration: none; font-size: 16px; font-weight: 500; transition: color 0.3s ease; }
        .main-menu__list > li > a:hover, .main-menu__list > li > a.active { color: #ffd700; }
        .header-buttons { display: flex; gap: 15px; }
        .btn-outline { padding: 10px 25px; border: 2px solid white; border-radius: 30px; color: white; text-decoration: none; font-weight: 500; transition: all 0.3s ease; }
        .btn-outline:hover { background: white; color: #667eea; }
        .btn-solid { padding: 10px 25px; background: white; border: 2px solid white; border-radius: 30px; color: #667eea; text-decoration: none; font-weight: 500; transition: all 0.3s ease; }
        .btn-solid:hover { background: transparent; color: white; }
        .mobile-nav__toggler { display: none; color: white; font-size: 24px; cursor: pointer; }
        .main-header.scrolled .mobile-nav__toggler { color: #333; }

        /* Page Header */
        .page-header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 150px 0 80px; color: white; text-align: center; position: relative; overflow: hidden; }
        .page-header::before { content: ''; position: absolute; top: -100px; right: -100px; width: 300px; height: 300px; background: rgba(255,255,255,0.05); border-radius: 50%; }
        .page-header::after { content: ''; position: absolute; bottom: -100px; left: -100px; width: 300px; height: 300px; background: rgba(255,255,255,0.05); border-radius: 50%; }
        .page-header h1 { font-size: 44px; font-weight: 700; margin-bottom: 16px; position: relative; }
        .page-header p { font-size: 16px; max-width: 700px; margin: 0 auto; opacity: 0.85; position: relative; }
        .breadcrumb { background: transparent; justify-content: center; margin-top: 20px; }
        .breadcrumb a { color: rgba(255,255,255,0.8); text-decoration: none; }
        .breadcrumb .active { color: white; }

        /* Legal Content */
        .legal-section { padding: 70px 0 90px; background: white; }
        .legal-content { max-width: 820px; margin: 0 auto; }
        .legal-content .updated { color: #667eea; font-weight: 600; margin-bottom: 40px; display: block; }
        .legal-content h2 { font-size: 24px; font-weight: 700; margin: 40px 0 16px; color: #1e1e1e; }
        .legal-content h2:first-of-type { margin-top: 0; }
        .legal-content p { font-size: 16px; line-height: 1.8; color: #555; margin-bottom: 16px; }
        .legal-content ul { margin: 0 0 16px 22px; }
        .legal-content li { font-size: 16px; line-height: 1.8; color: #555; margin-bottom: 8px; }
        .legal-content a { color: #667eea; font-weight: 500; }
        .legal-content strong { color: #1e1e1e; }
        .legal-callout { background: #f8f9fa; border-left: 4px solid #667eea; border-radius: 10px; padding: 20px 25px; margin: 30px 0; }
        .legal-callout p { margin: 0; color: #555; }

        /* Footer */
        .site-footer { background: #1e1e1e; color: white; padding: 60px 0 30px; }
        .footer-widget { margin-bottom: 30px; }
        .footer-logo { max-width: 150px; margin-bottom: 20px; }
        .footer-widget p { color: rgba(255,255,255,0.7); line-height: 1.8; margin-bottom: 20px; }
        .footer-social { display: flex; gap: 15px; }
        .footer-social a { width: 40px; height: 40px; background: rgba(255,255,255,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; transition: all 0.3s ease; }
        .footer-social a:hover { background: #667eea; transform: translateY(-3px); }
        .footer-widget h4 { font-size: 18px; font-weight: 600; margin-bottom: 20px; }
        .footer-links { list-style: none; padding: 0; }
        .footer-links li { margin-bottom: 10px; }
        .footer-links a { color: rgba(255,255,255,0.7); text-decoration: none; transition: color 0.3s ease; }
        .footer-links a:hover { color: white; }
        .footer-contact { list-style: none; padding: 0; }
        .footer-contact li { display: flex; align-items: center; gap: 10px; color: rgba(255,255,255,0.7); margin-bottom: 15px; }
        .footer-contact i { width: 30px; color: #667eea; }
        .footer-bottom { margin-top: 50px; padding-top: 30px; border-top: 1px solid rgba(255,255,255,0.1); text-align: center; color: rgba(255,255,255,0.5); font-size: 14px; }

        /* Mobile Menu */
        .mobile-menu { position: fixed; top: 0; left: -100%; width: 300px; height: 100vh; background: white; z-index: 10000; padding: 40px 20px; transition: left 0.4s ease; box-shadow: 2px 0 20px rgba(0,0,0,0.1); }
        .mobile-menu.open { left: 0; }
        .mobile-menu-close { position: absolute; top: 20px; right: 20px; font-size: 24px; cursor: pointer; color: #333; }
        .mobile-menu-logo { margin-bottom: 40px; }
        .mobile-menu-logo img { max-width: 150px; }
        .mobile-menu-links { list-style: none; padding: 0; }
        .mobile-menu-links li { margin-bottom: 15px; }
        .mobile-menu-links a { color: #333; text-decoration: none; font-size: 16px; font-weight: 500; display: block; padding: 10px; border-radius: 8px; transition: all 0.3s ease; }
        .mobile-menu-links a:hover { background: #f0f0f0; padding-left: 20px; }
        .mobile-menu-buttons { margin-top: 30px; display: flex; flex-direction: column; gap: 10px; }
        .mobile-menu-buttons .btn-outline { border-color: #667eea; color: #667eea; text-align: center; }
        .mobile-menu-buttons .btn-solid { background: #667eea; color: white; text-align: center; }

        @media (max-width: 991px) {
            .main-menu__list { display: none; }
            .header-buttons { display: none; }
            .mobile-nav__toggler { display: block; }
            .page-header h1 { font-size: 32px; }
        }

    </style>
</head>

<body>
    <!-- Header -->
    <header class="main-header" id="mainHeader">
        <div class="container">
            <div class="main-menu-wrapper">
                <div class="main-menu-wrapper__logo">
                    <a href="/">
                        <img src="/assets/images/resources/care-logo-white.png" alt="CareShed">
                    </a>
                </div>
                <div class="main-menu-wrapper__main-menu">
                    <ul class="main-menu__list">
                        <li><a href="/">Home</a></li>
                        <li><a href="/how-it-works">How It Works</a></li>
                        <li><a href="/features">Features</a></li>
                        <li><a href="/pricing">Pricing</a></li>
                        <li><a href="/about">About Us</a></li>
                        <li><a href="/contact">Contact</a></li>
                    </ul>
                </div>
                <div class="header-buttons">
                    <a href="/login" class="btn-outline">Login</a>
                    <a href="/register" class="btn-solid">Start Free Trial</a>
                </div>
                <a href="#" class="mobile-nav__toggler" id="mobileToggler">
                    <i class="fa fa-bars"></i>
                </a>
            </div>
        </div>
    </header>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
        <span class="mobile-menu-close" id="mobileClose"><i class="fa fa-times"></i></span>
        <div class="mobile-menu-logo">
            <img src="/assets/images/resources/careshed-logo.png" alt="CareShed">
        </div>
        <ul class="mobile-menu-links">
            <li><a href="/">Home</a></li>
            <li><a href="/how-it-works">How It Works</a></li>
            <li><a href="/features">Features</a></li>
            <li><a href="/pricing">Pricing</a></li>
            <li><a href="/about">About Us</a></li>
            <li><a href="/contact">Contact</a></li>
        </ul>
        <div class="mobile-menu-buttons">
            <a href="/login" class="btn-outline">Login</a>
            <a href="/register" class="btn-solid">Start Free Trial</a>
        </div>
    </div>

    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <h1>CQC Compliance</h1>
            <p>How CareShed helps UK care providers organise the records CQC inspections look for.</p>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">CQC Compliance</li>
                </ol>
            </nav>
        </div>
    </section>

    <!-- Legal Content -->
    <section class="legal-section">
        <div class="container">
            <div class="legal-content">
                <span class="updated">Last updated: <%= moment().format('D MMMM YYYY') %></span>

                <h2>1. Our Role</h2>
                <p>CareShed is a software platform used by care providers to manage their operations. CareShed itself is not a CQC-registered care provider and does not deliver regulated care activity. Regulatory compliance with the Care Quality Commission ("CQC") remains the responsibility of each care provider using the Service.</p>

                <div class="legal-callout">
                    <p>Using CareShed helps care providers organise the records CQC inspectors typically expect to see, but it does not itself guarantee compliance. Care providers remain responsible for the quality and accuracy of the information they record, and for meeting all applicable regulatory requirements.</p>
                </div>

                <h2>2. How CareShed Supports CQC Compliance</h2>
                <p>The platform is built around the kind of structured record-keeping CQC inspections look for, including:</p>
                <ul>
                    <li>Digital care plans that can be reviewed and updated as a service user's needs change.</li>
                    <li>Time-stamped visit and interaction logs, including medication administration records.</li>
                    <li>Staff records, including DBS check tracking, qualifications, and training completion.</li>
                    <li>Incident and safeguarding flags raised directly from a care visit.</li>
                    <li>Audit trails showing who recorded or updated a piece of information, and when.</li>
                </ul>

                <h2>3. Mapping to the CQC Key Questions</h2>
                <p>CQC assesses services against five key questions: are they Safe, Effective, Caring, Responsive, and Well-led. CareShed's scheduling, care planning, incident reporting, and reporting tools are designed to help providers gather and present evidence against each of these areas &mdash; but the underlying quality of care remains the responsibility of the provider and their staff.</p>

                <h2>4. Data Security and Compliance</h2>
                <p>We process data in line with UK GDPR and the Data Protection Act 2018, using encrypted connections and role-based access controls so that staff only see the records relevant to their role. See our <a href="/privacy">Privacy Policy</a> for more detail.</p>

                <h2>5. Disclaimer</h2>
                <p>This page is provided for general information and does not constitute regulatory or legal advice. Care providers should refer to current CQC guidance and take their own professional advice on meeting their regulatory obligations.</p>

                <h2>6. Contact Us</h2>
                <p>If you have questions about how CareShed supports compliance record-keeping, contact us at <a href="mailto:hello@careshed.co.uk">hello@careshed.co.uk</a>.</p>

            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer id="contact" class="site-footer">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6">
                    <div class="footer-widget">
                        <img src="/assets/images/resources/care-logo-white.png" alt="CareShed" class="footer-logo">
                        <p>Complete care management platform for UK care providers. CQC compliant, secure, and easy to use.</p>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <div class="footer-widget">
                        <h4>Quick Links</h4>
                        <ul class="footer-links">
                            <li><a href="/">Home</a></li>
                            <li><a href="/how-it-works">How It Works</a></li>
                            <li><a href="/features">Features</a></li>
                            <li><a href="/pricing">Pricing</a></li>
                            <li><a href="/about">About Us</a></li>
                            <li><a href="/contact">Contact</a></li>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="footer-widget">
                        <h4>Legal</h4>
                        <ul class="footer-links">
                            <li><a href="/privacy">Privacy Policy</a></li>
                            <li><a href="/terms">Terms of Use</a></li>
                            <li><a href="/cookies">Cookie Policy</a></li>
                            <li><a href="/compliance">CQC Compliance</a></li>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="footer-widget">
                        <h4>Contact Us</h4>
                        <ul class="footer-contact">
                            <li><i class="fas fa-envelope"></i> hello@careshed.co.uk</li>
                        </ul>
                        <div class="footer-social">
                            <a href="https://www.facebook.com/careshed"><i class="fab fa-facebook"></i></a>
                            <a href="https://linkedin.com/company/careshed"><i class="fab fa-linkedin"></i></a>
                            <a href="https://instagram.com/careshed"><i class="fab fa-instagram"></i></a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; <%= new Date().getFullYear() %> CareShed. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="/assets/vendors/jquery/jquery-3.6.0.min.js"></script>
    <script src="/assets/vendors/bootstrap/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function() {
            $(window).scroll(function() {
                if ($(this).scrollTop() > 100) {
                    $('#mainHeader').addClass('scrolled');
                } else {
                    $('#mainHeader').removeClass('scrolled');
                }
            });

            $('#mobileToggler').click(function(e) {
                e.preventDefault();
                $('#mobileMenu').addClass('open');
            });

            $('#mobileClose').click(function(e) {
                e.preventDefault();
                $('#mobileMenu').removeClass('open');
            });

            $('.mobile-menu-links a').click(function() {
                $('#mobileMenu').removeClass('open');
            });
        });
    </script>
</body>
</html>
