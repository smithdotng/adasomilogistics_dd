NODE_ENV=development
APP_URL=http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017/adasomi

# Session cookie encryption - must be at least 32 characters, keep secret.
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# Outgoing mail (Hostinger) - used for email verification links.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=deliveries@adasomilogistics.com
SMTP_PASS=your-mailbox-password-here
MAIL_FROM="Adasomi Logistics" <deliveries@adasomilogistics.com>
