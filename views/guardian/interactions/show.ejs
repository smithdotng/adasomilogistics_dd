<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Interaction Details || Care System Guardian</title>
    
    <!-- favicons Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicons/favicon-16x16.png" />
    <link rel="manifest" href="/assets/images/favicons/site.webmanifest" />
    <meta name="description" content="Care System - Guardian Interaction Details" />

    <!-- fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <!-- CSS libraries -->
    <link rel="stylesheet" href="/assets/vendors/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/assets/vendors/animate/animate.min.css" />
    <link rel="stylesheet" href="/assets/vendors/animate/custom-animate.css" />
    <link rel="stylesheet" href="/assets/vendors/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="/assets/vendors/jarallax/jarallax.css" />
    <link rel="stylesheet" href="/assets/vendors/jquery-magnific-popup/jquery.magnific-popup.css" />
    <link rel="stylesheet" href="/assets/vendors/nouislider/nouislider.min.css" />
    <link rel="stylesheet" href="/assets/vendors/nouislider/nouislider.pips.css" />
    <link rel="stylesheet" href="/assets/vendors/odometer/odometer.min.css" />
    <link rel="stylesheet" href="/assets/vendors/swiper/swiper.min.css" />
    <link rel="stylesheet" href="/assets/vendors/sominx-icons/style.css">
    <link rel="stylesheet" href="/assets/vendors/tiny-slider/tiny-slider.min.css" />
    <link rel="stylesheet" href="/assets/vendors/reey-font/stylesheet.css" />
    <link rel="stylesheet" href="/assets/vendors/owl-carousel/owl.carousel.min.css" />
    <link rel="stylesheet" href="/assets/vendors/owl-carousel/owl.theme.default.min.css" />
    <link rel="stylesheet" href="/assets/vendors/twentytwenty/twentytwenty.css" />
    <link rel="stylesheet" href="/assets/vendors/bxslider/jquery.bxslider.css" />
    <link rel="stylesheet" href="/assets/vendors/bootstrap-select/css/bootstrap-select.min.css" />
    <link rel="stylesheet" href="/assets/vendors/vegas/vegas.min.css" />
    <link rel="stylesheet" href="/assets/vendors/jquery-ui/jquery-ui.css" />
    <link rel="stylesheet" href="/assets/vendors/timepicker/timePicker.css" />

    <!-- template styles -->
    <link rel="stylesheet" href="/assets/css/sominx.css" />
    <link rel="stylesheet" href="/assets/css/sominx-responsive.css" />
    
    <!-- Guardian Interaction Show Styles -->
    <style>
        :root {
            --guardian-primary: #4a8b8f;
            --guardian-secondary: #f5a623;
            --guardian-accent: #7b68ee;
        }
        
        .interaction-header {
            background: #fff;
            border-radius: 10px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0px 10px 60px 0px rgba(0, 0, 0, 0.07);
        }
        
        .interaction-detail-card {
            background: #fff;
            border-radius: 10px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0px 10px 60px 0px rgba(0, 0, 0, 0.07);
        }
        
        .detail-section {
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid #f0f0f0;
        }
        
        .detail-section:last-child {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }
        
        .detail-label {
            font-weight: 600;
            color: var(--guardian-primary);
            margin-bottom: 5px;
            font-size: 14px;
            text-transform: uppercase;
        }
        
        .detail-value {
            font-size: 16px;
            color: #333;
            margin-bottom: 15px;
        }
        
        .type-badge {
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            display: inline-block;
        }
        
        .type-family_meeting {
            background: rgba(111, 66, 193, 0.1);
            color: #6f42c1;
        }
        
        .type-phone_call {
            background: rgba(40, 167, 69, 0.1);
            color: #28a745;
        }
        
        .type-visit {
            background: rgba(23, 162, 184, 0.1);
            color: #17a2b8;
        }
        
        .type-emergency {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }
        
        .type-email {
            background: rgba(253, 126, 20, 0.1);
            color: #fd7e14;
        }
        
        .type-other {
            background: rgba(108, 117, 125, 0.1);
            color: #6c757d;
        }
        
        .status-badge {
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            display: inline-block;
        }
        
        .status-completed {
            background: rgba(40, 167, 69, 0.1);
            color: #28a745;
        }
        
        .status-draft {
            background: rgba(108, 117, 125, 0.1);
            color: #6c757d;
        }
        
        .status-cancelled {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }
        
        .verified-badge {
            background: rgba(74, 139, 143, 0.1);
            color: var(--guardian-primary);
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 12px;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }
        
        .file-card {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 10px;
            transition: all 0.3s ease;
        }
        
        .file-card:hover {
            background: #e9ecef;
            border-color: #dee2e6;
        }
        
        .file-icon {
            font-size: 24px;
            color: var(--guardian-primary);
            margin-right: 10px;
        }
        
        .file-download-btn {
            background: var(--guardian-primary);
            color: white;
            border: none;
            border-radius: 6px;
            padding: 5px 15px;
            font-size: 12px;
            transition: all 0.3s ease;
        }
        
        .file-download-btn:hover {
            background: #3a7b7f;
            color: white;
        }
        
        .empty-state {
            text-align: center;
            padding: 40px 20px;
            background: #f8f9fa;
            border-radius: 8px;
            color: #6c757d;
        }
        
        .timeline {
            position: relative;
            padding-left: 30px;
        }
        
        .timeline:before {
            content: '';
            position: absolute;
            left: 15px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: var(--guardian-primary);
        }
        
        .timeline-item {
            position: relative;
            margin-bottom: 20px;
        }
        
        .timeline-item:last-child {
            margin-bottom: 0;
        }
        
        .timeline-item:before {
            content: '';
            position: absolute;
            left: -25px;
            top: 5px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: var(--guardian-primary);
            border: 3px solid white;
            box-shadow: 0 0 0 3px rgba(74, 139, 143, 0.2);
        }
        
        .timeline-date {
            font-size: 12px;
            color: #6c757d;
            margin-bottom: 5px;
        }
        
        .timeline-content {
            background: white;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 15px;
        }
        
        .service-user-badge {
            display: inline-block;
            background: rgba(74, 139, 143, 0.1);
            color: var(--guardian-primary);
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
        }
        
        .action-buttons {
            display: flex;
            gap: 10px;
        }
        
        .action-btn {
            padding: 8px 20px;
            border-radius: 8px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            transition: all 0.3s ease;
        }
        
        .action-btn-back {
            background: #6c757d;
            color: white;
            border: 1px solid #6c757d;
        }
        
        .action-btn-edit {
            background: rgba(253, 126, 20, 0.1);
            color: #fd7e14;
            border: 1px solid #fd7e14;
        }
        
        .action-btn-delete {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
            border: 1px solid #dc3545;
        }
        
        .action-btn:hover {
            opacity: 0.9;
            text-decoration: none;
        }
        
        .observation-note {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 8px;
            padding: 15px;
            margin-top: 10px;
        }
        
        .duration-display {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 6px;
            padding: 10px 15px;
            display: inline-block;
            font-weight: 600;
            color: #495057;
        }
    </style>
</head>

<body>
    <div class="preloader">
        <img class="preloader__image" width="60" src="/assets/images/loader.png" alt="" />
    </div>
    <!-- /.preloader -->
    
    <div class="page-wrapper">
        <!-- Header Start -->
        <header class="main-header clearfix">
            <nav class="main-menu clearfix">
                <div class="main-menu-wrapper clearfix">
                    <div class="main-menu-wrapper-inner clearfix">
                        <div class="main-menu-wrapper__left clearfix">
                            <div class="main-menu-wrapper__logo">
                                <a href="/"><img src="/assets/images/resources/logo-1.jpg" alt="Care System"></a>
                            </div>
                            <div class="main-menu-wrapper__main-menu">
                                <a href="#" class="mobile-nav__toggler"><i class="fa fa-bars"></i></a>
                                <ul class="main-menu__list">
                                    <li><a href="/guardian/dashboard">Dashboard</a></li>
                                    <li><a href="/guardian/service-user">Service User Information</a></li>
                                    <li class="current"><a href="/guardian/interactions">Interactions</a></li>
                                    <li><a href="/guardian/documents">Documents</a></li>
                                    <li><a href="/guardian/change-password">Settings</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="main-menu-wrapper__right">
                            <div class="main-menu-wrapper__call">
                                <div class="main-menu-wrapper__call-icon">
                                    <span class="icon-user-check"></span>
                                </div>
                                <div class="main-menu-wrapper__call-number">
                                    <p>Welcome back</p>
                                    <a href="/guardian/change-password"><%= user.fullName %></a>
                                </div>
                            </div>
                            <div class="main-menu-wrapper__search-box">
                                <a href="/logout" class="main-menu-wrapper__logout" title="Logout">
                                    <i class="fas fa-sign-out-alt"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
        <!-- Header End -->

        <div class="stricky-header stricked-menu main-menu">
            <div class="sticky-header__content"></div>
        </div>

        <!--Page Header Start-->
        <section class="page-header" style="padding: 60px 0 40px;">
            <div class="container">
                <div class="page-header__inner">
                    <div class="service-user-badge mb-3">
                        <i class="fas fa-user me-2"></i>
                        <%= serviceUser.firstName %> <%= serviceUser.lastName %>
                    </div>
                    <h2>Interaction Details</h2>
                </div>
            </div>
        </section>
        <!--Page Header End-->

        <!-- Interaction Details Content Start -->
        <section class="interactions-content pt-80 pb-120">
            <div class="container">
                <!-- Header with Actions -->
                <div class="interaction-header wow fadeInUp" data-wow-delay="100ms">
                    <div class="row align-items-center">
                        <div class="col-lg-8">
                            <h3 class="mb-3">
                                <i class="fas fa-clipboard-check text-primary me-2"></i>
                                <%= interaction.title %>
                            </h3>
                            <p class="text-muted mb-0">
                                Interaction recorded on <%= moment(interaction.startTime).format('MMMM D, YYYY [at] h:mm A') %>
                            </p>
                        </div>
                        <div class="col-lg-4 text-lg-end">
                            <div class="action-buttons">
                                <a href="/guardian/interactions" class="action-btn action-btn-back">
                                    <i class="fas fa-arrow-left me-2"></i>Back
                                </a>
                                <% if (interaction.supportWorker && interaction.supportWorker._id.toString() === user.id && interaction.status === 'draft') { %>
                                    <a href="/guardian/interactions/<%= interaction._id %>/edit" class="action-btn action-btn-edit">
                                        <i class="fas fa-edit me-2"></i>Edit
                                    </a>
                                    <form action="/guardian/interactions/<%= interaction._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this interaction? This action cannot be undone.');">
                                        <button type="submit" class="action-btn action-btn-delete">
                                            <i class="fas fa-trash me-2"></i>Delete
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Guardian Verification Notice -->
                <% if (interaction.supportWorker && interaction.supportWorker._id.toString() === user.id) { %>
                    <div class="alert alert-info mb-4 wow fadeInUp" data-wow-delay="150ms">
                        <i class="fas fa-user-shield me-2"></i>
                        <strong>You logged this interaction</strong> on <%= moment(interaction.createdAt).format('MMMM D, YYYY [at] h:mm A') %>
                        <% if (interaction.verifiedByGuardian) { %>
                            <span class="verified-badge ms-2">
                                <i class="fas fa-check-circle"></i> Verified by Guardian
                            </span>
                        <% } %>
                    </div>
                <% } %>

                <div class="row">
                    <!-- Main Interaction Details -->
                    <div class="col-lg-8">
                        <div class="interaction-detail-card wow fadeInUp" data-wow-delay="200ms">
                            <!-- Basic Information -->
                            <div class="detail-section">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="detail-label">Interaction Type</div>
                                        <div class="detail-value">
                                            <span class="type-badge type-<%= interaction.type %>">
                                                <i class="fas fa-<%= 
                                                    interaction.type === 'family_meeting' ? 'users' : 
                                                    interaction.type === 'phone_call' ? 'phone' :
                                                    interaction.type === 'visit' ? 'home' :
                                                    interaction.type === 'emergency' ? 'exclamation-triangle' :
                                                    interaction.type === 'email' ? 'envelope' : 'clipboard' 
                                                %> me-1"></i>
                                                <%= interaction.type.replace('_', ' ') %>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="detail-label">Status</div>
                                        <div class="detail-value">
                                            <span class="status-badge status-<%= interaction.status %>">
                                                <i class="fas fa-<%= 
                                                    interaction.status === 'completed' ? 'check-circle' :
                                                    interaction.status === 'draft' ? 'edit' : 'times-circle' 
                                                %> me-1"></i>
                                                <%= interaction.status %>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="row mt-3">
                                    <div class="col-md-6">
                                        <div class="detail-label">Date & Time</div>
                                        <div class="detail-value">
                                            <i class="fas fa-calendar-alt me-2 text-muted"></i>
                                            <%= moment(interaction.startTime).format('dddd, MMMM D, YYYY') %><br>
                                            <small class="text-muted">
                                                <%= moment(interaction.startTime).format('h:mm A') %> 
                                                <% if (interaction.endTime) { %>
                                                    to <%= moment(interaction.endTime).format('h:mm A') %>
                                                <% } %>
                                            </small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="detail-label">Duration</div>
                                        <div class="detail-value">
                                            <% 
                                                let durationText = 'Not specified';
                                                if (interaction.duration) {
                                                    let durationHtml = '';
                                                    if (interaction.duration.hours > 0) {
                                                        durationHtml += interaction.duration.hours + ' hour' + (interaction.duration.hours !== 1 ? 's' : '') + ' ';
                                                    }
                                                    if (interaction.duration.minutes > 0) {
                                                        durationHtml += interaction.duration.minutes + ' minute' + (interaction.duration.minutes !== 1 ? 's' : '');
                                                    }
                                                    durationText = durationHtml.trim();
                                                } else if (interaction.endTime) {
                                                    const start = new Date(interaction.startTime);
                                                    const end = new Date(interaction.endTime);
                                                    const durationMs = end - start;
                                                    const hours = Math.floor(durationMs / (1000 * 60 * 60));
                                                    const minutes = Math.floor((durationMs % (1000 * 60 * 60)) / (1000 * 60));
                                                    
                                                    let durationHtml = '';
                                                    if (hours > 0) {
                                                        durationHtml += hours + ' hour' + (hours !== 1 ? 's' : '') + ' ';
                                                    }
                                                    if (minutes > 0) {
                                                        durationHtml += minutes + ' minute' + (minutes !== 1 ? 's' : '');
                                                    }
                                                    durationText = durationHtml.trim();
                                                }
                                            %>
                                            <div class="duration-display">
                                                <i class="fas fa-clock me-2"></i>
                                                <%= durationText %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="row mt-3">
                                    <div class="col-md-6">
                                        <div class="detail-label">Location</div>
                                        <div class="detail-value">
                                            <i class="fas fa-map-marker-alt me-2 text-muted"></i>
                                            <%= interaction.location ? interaction.location.replace('_', ' ') : 'Not specified' %>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="detail-label">Logged By</div>
                                        <div class="detail-value">
                                            <% if (interaction.supportWorker) { %>
                                                <i class="fas fa-user me-2 text-muted"></i>
                                                <%= interaction.supportWorker.firstName %> <%= interaction.supportWorker.lastName %>
                                                <% if (interaction.supportWorker._id.toString() === user.id) { %>
                                                    <span class="badge bg-info ms-2">You</span>
                                                <% } %>
                                            <% } else { %>
                                                <span class="text-muted">Not specified</span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Description -->
                            <div class="detail-section">
                                <div class="detail-label">Description</div>
                                <div class="detail-value">
                                    <div style="white-space: pre-wrap; line-height: 1.6;"><%= interaction.description %></div>
                                </div>
                            </div>

                            <!-- Observations -->
                            <% if (interaction.observations && interaction.observations.notes) { %>
                            <div class="detail-section">
                                <div class="detail-label">Service User Observations</div>
                                <div class="detail-value observation-note">
                                    <i class="fas fa-eye me-2"></i>
                                    <%= interaction.observations.notes %>
                                </div>
                            </div>
                            <% } %>

                            <!-- Additional Notes -->
                            <% if (interaction.verificationNotes) { %>
                            <div class="detail-section">
                                <div class="detail-label">Additional Notes</div>
                                <div class="detail-value">
                                    <div style="white-space: pre-wrap; line-height: 1.6;"><%= interaction.verificationNotes %></div>
                                </div>
                            </div>
                            <% } %>
                        </div>

                        <!-- Attachments -->
                        <% if (interaction.attachments && interaction.attachments.length > 0) { %>
                        <div class="interaction-detail-card wow fadeInUp" data-wow-delay="250ms">
                            <h5 class="mb-4">
                                <i class="fas fa-paperclip me-2"></i>Attachments
                                <span class="badge bg-secondary ms-2"><%= interaction.attachments.length %></span>
                            </h5>
                            
                            <div class="row">
                                <% interaction.attachments.forEach(function(file, index) { %>
                                <div class="col-md-6 mb-3">
                                    <div class="file-card">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div class="d-flex align-items-center">
                                                <div class="file-icon">
                                                    <i class="fas fa-<%= 
                                                        file.fileType === 'pdf' ? 'file-pdf' :
                                                        file.fileType === 'doc' || file.fileType === 'docx' ? 'file-word' :
                                                        file.fileType === 'jpg' || file.fileType === 'jpeg' || file.fileType === 'png' ? 'file-image' :
                                                        'file' 
                                                    %>"></i>
                                                </div>
                                                <div>
                                                    <div class="file-name" style="font-size: 14px; max-width: 200px; overflow: hidden; text-overflow: ellipsis;">
                                                        <%= file.name %>
                                                    </div>
                                                    <small class="text-muted">
                                                        <%= file.fileType.toUpperCase() %> • 
                                                        <%= moment(file.uploadedAt).format('MMM D, YYYY') %>
                                                    </small>
                                                </div>
                                            </div>
                                            <a href="<%= file.url %>" target="_blank" class="file-download-btn">
                                                <i class="fas fa-download me-1"></i>View
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <% }); %>
                            </div>
                        </div>
                        <% } %>
                    </div>

                    <!-- Sidebar Information -->
                    <div class="col-lg-4">
                        <!-- Service User Information -->
                        <div class="interaction-detail-card wow fadeInUp" data-wow-delay="300ms">
                            <h5 class="mb-4">
                                <i class="fas fa-user me-2"></i>Service User Information
                            </h5>
                            
                            <div class="detail-label">Name</div>
                            <div class="detail-value mb-3">
                                <strong><%= serviceUser.firstName %> <%= serviceUser.lastName %></strong>
                            </div>
                            
                            <div class="detail-label">Age</div>
                            <div class="detail-value mb-3">
                                <%= serviceUser.age %> years old
                            </div>
                            
                            <div class="detail-label">Care Level</div>
                            <div class="detail-value mb-3">
                                <span class="badge bg-<%= 
                                    serviceUser.careInfo.careLevel === 'high' ? 'danger' :
                                    serviceUser.careInfo.careLevel === 'medium' ? 'warning' : 'success'
                                %>">
                                    <%= serviceUser.careInfo.careLevel %>
                                </span>
                            </div>
                            
                            <div class="detail-label">Assigned Support Worker</div>
                            <div class="detail-value">
                                <% if (serviceUser.assignedSupportWorker) { %>
                                    <%= serviceUser.assignedSupportWorker.firstName %> <%= serviceUser.assignedSupportWorker.lastName %>
                                <% } else { %>
                                    <span class="text-muted">Not assigned</span>
                                <% } %>
                            </div>
                        </div>

                        <!-- Interaction Timeline -->
                        <div class="interaction-detail-card wow fadeInUp" data-wow-delay="350ms">
                            <h5 class="mb-4">
                                <i class="fas fa-history me-2"></i>Interaction Timeline
                            </h5>
                            
                            <div class="timeline">
                                <div class="timeline-item">
                                    <div class="timeline-date">
                                        <%= moment(interaction.startTime).format('MMM D, YYYY h:mm A') %>
                                    </div>
                                    <div class="timeline-content">
                                        <strong>Interaction Started</strong><br>
                                        <small class="text-muted">Logged by 
                                            <% if (interaction.supportWorker) { %>
                                                <%= interaction.supportWorker.firstName %> <%= interaction.supportWorker.lastName %>
                                            <% } else { %>
                                                Guardian
                                            <% } %>
                                        </small>
                                    </div>
                                </div>
                                
                                <% if (interaction.endTime) { %>
                                <div class="timeline-item">
                                    <div class="timeline-date">
                                        <%= moment(interaction.endTime).format('MMM D, YYYY h:mm A') %>
                                    </div>
                                    <div class="timeline-content">
                                        <strong>Interaction Ended</strong><br>
                                        <small class="text-muted">
                                            <% 
                                                const start = new Date(interaction.startTime);
                                                const end = new Date(interaction.endTime);
                                                const durationMs = end - start;
                                                const hours = Math.floor(durationMs / (1000 * 60 * 60));
                                                const minutes = Math.floor((durationMs % (1000 * 60 * 60)) / (1000 * 60));
                                            %>
                                            Duration: 
                                            <% if (hours > 0) { %><%= hours %>h <% } %>
                                            <% if (minutes > 0) { %><%= minutes %>m<% } %>
                                        </small>
                                    </div>
                                </div>
                                <% } %>
                                
                                <div class="timeline-item">
                                    <div class="timeline-date">
                                        <%= moment(interaction.createdAt).format('MMM D, YYYY h:mm A') %>
                                    </div>
                                    <div class="timeline-content">
                                        <strong>Record Created</strong><br>
                                        <small class="text-muted">Added to system</small>
                                    </div>
                                </div>
                                
                                <% if (interaction.updatedAt && interaction.updatedAt.getTime() !== interaction.createdAt.getTime()) { %>
                                <div class="timeline-item">
                                    <div class="timeline-date">
                                        <%= moment(interaction.updatedAt).format('MMM D, YYYY h:mm A') %>
                                    </div>
                                    <div class="timeline-content">
                                        <strong>Last Updated</strong><br>
                                        <small class="text-muted">Record modified</small>
                                    </div>
                                </div>
                                <% } %>
                            </div>
                        </div>

