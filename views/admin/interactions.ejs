    <!-- Custom Interactions Page Script -->
    <script>
        $(document).ready(function() {
            // Initialize WOW.js
            if ($('.wow').length) {
                new WOW().init();
            }
            
            // Set default dates for date filters
            const today = new Date().toISOString().split('T')[0];
            const oneWeekAgo = new Date();
            oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);
            const oneWeekAgoStr = oneWeekAgo.toISOString().split('T')[0];
            
            // If startDate is empty, set to one week ago
            if (!$('input[name="startDate"]').val()) {
                $('input[name="startDate"]').val(oneWeekAgoStr);
            }
            
            // If endDate is empty, set to today
            if (!$('input[name="endDate"]').val()) {
                $('input[name="endDate"]').val(today);
            }
            
            // Add animation to table rows on hover
            $('table tbody tr').hover(
                function() {
                    $(this).css('transition', 'all 0.3s ease');
                },
                function() {
                    $(this).css('transition', 'all 0.3s ease');
                }
            );
            
            // Handle filter form submission
            $('form').on('submit', function() {
                // Show loading state
                $('button[type="submit"]').html('<i class="fas fa-spinner fa-spin me-2"></i>Filtering...').prop('disabled', true);
            });
        });
    </script>
