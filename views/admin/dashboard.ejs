    <!-- Custom Dashboard Scripts -->
    <script>
        $(document).ready(function() {
            // Odometer animation
            $('.odometer').each(function() {
                var $this = $(this);
                var count = parseInt($this.data('count')) || 0;
                
                $({ val: 0 }).animate({ val: count }, {
                    duration: 2000,
                    easing: 'swing',
                    step: function() {
                        $this.text(Math.floor(this.val));
                    }
                });
            });
            
            // Initialize WOW.js
            if ($('.wow').length) {
                var wow = new WOW({
                    boxClass: 'wow',
                    animateClass: 'animated',
                    offset: 0,
                    mobile: true,
                    live: true
                });
                wow.init();
            }
            
            // Auto-refresh dashboard every 60 seconds
            setTimeout(function() {
                location.reload();
            }, 60000);
            
            // Handle logout
            $('.main-menu-wrapper__logout').on('click', function(e) {
                if (!confirm('Are you sure you want to logout?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
