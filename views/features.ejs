                </div>
                <div class="col-lg-6">
                    <div class="feature-image">
                        <img src="/assets/images/feature-mobile.jpg" alt="Mobile Interaction Logging" class="img-fluid">
                    </div>
                </div>
            </div>

            <!-- Feature 6 -->
            <div class="feature-item row align-items-center flex-row-reverse">
                <div class="col-lg-6">
                    <div class="feature-icon-large">
                        <i class="fas fa-pound-sign"></i>
                    </div>
