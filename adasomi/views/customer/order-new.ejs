<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'Request a Rider', includeMap: true }) %>
</head>
<body>
<%- include('../partials/header') %>
<%- include('../partials/flash') %>

<main class="page-shell">
    <div class="container">
        <p class="section-title mb-1">Direct Dispatch</p>
        <h2 class="mb-4">Request a rider</h2>

        <form action="/customer/orders" method="POST">
            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="card mb-4">
                        <div class="card-header">Pickup &amp; Drop-off</div>
                        <div class="card-body">
                            <p id="map-instruction" class="text-muted small">Click the map to drop a <strong>pickup</strong> pin, then click again for the <strong>drop-off</strong> pin.</p>
                            <div id="order-map" class="tracking-map mb-3" data-config='<%- JSON.stringify({baseFee: config.baseFee, perKmRate: config.perKmRate, peakSurcharge: config.peakSurcharge, peakWindows: config.peakWindows}) %>'></div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Pickup Address</label>
                                    <input type="text" class="form-control" name="pickupAddress" required placeholder="e.g. 5 Broad Street">
                                    <input type="hidden" id="pickupLat" name="pickupLat" required>
                                    <input type="hidden" id="pickupLng" name="pickupLng" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Drop-off Address</label>
                                    <input type="text" class="form-control" name="dropoffAddress" required placeholder="e.g. 22 Adeola Odeku St">
                                    <input type="hidden" id="dropoffLat" name="dropoffLat" required>
                                    <input type="hidden" id="dropoffLng" name="dropoffLng" required>
                                </div>
                            </div>
                            <div class="mt-3 text-muted small">Distance: <strong id="distancePreview">—</strong></div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">Recipient &amp; Parcel</div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Recipient Name</label>
                                    <input type="text" class="form-control" name="recipientName" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Recipient Phone</label>
                                    <input type="text" class="form-control" name="recipientPhone" required>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">What are we sending?</label>
                                    <input type="text" class="form-control" name="itemsDescription" placeholder="e.g. Documents, a small parcel…">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="card" style="position:sticky; top:90px;">
                        <div class="card-header">Logistics Fee Preview</div>
                        <div class="card-body">
                            <div id="pricingPreview" class="pricing-box d-none">
                                <div class="row-line"><span>Base Fee</span><span id="pv-baseFee">—</span></div>
                                <div class="row-line"><span>Distance Cost</span><span id="pv-distanceCost">—</span></div>
                                <div class="row-line"><span>Peak Surcharge</span><span id="pv-peakSurcharge">—</span></div>
                                <div class="row-line total"><span>Total to Pay</span><span id="pv-total">—</span></div>
                            </div>
                            <p class="text-muted small mt-3 mb-0">Set the pickup &amp; drop-off pins to see your fee.</p>
                            <button type="submit" class="btn btn-peach w-100 mt-4"><i class="fa-solid fa-truck-fast me-2"></i>Request Rider</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</main>
<%- include('../partials/footer', { includeMap: true }) %>
</body>
</html>
