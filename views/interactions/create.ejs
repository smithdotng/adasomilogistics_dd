    <!-- Custom Create Interaction Script -->
    <script>
        $(document).ready(function() {
            // Initialize WOW.js
            if ($('.wow').length) {
                new WOW().init();
            }
            
            // Set default date/time to now for start time
            const now = new Date();
            const timezoneOffset = now.getTimezoneOffset() * 60000;
            const localISOTime = new Date(now - timezoneOffset).toISOString().slice(0, 16);
            $('#startTime').val(localISOTime);
            
            // Set end time to 1 hour from now
            const endTime = new Date(now.getTime() + 60 * 60 * 1000);
            const endISOTime = new Date(endTime - timezoneOffset).toISOString().slice(0, 16);
            $('#endTime').val(endISOTime);
            
            // Type selection
            $('#typeSelection .type-option').click(function() {
                const type = $(this).data('type');
                $('#typeSelection .type-option').removeClass('active');
                $(this).addClass('active');
                $(this).find('input[type="radio"]').prop('checked', true).trigger('change');
                $('#typeError').hide();
            });
            
            // Task management
            let taskCounter = 0;
            const tasks = [];
            
            $('#addTaskBtn').click(function() {
                taskCounter++;
                const taskId = 'task_' + taskCounter;
                const taskHtml = `
                    <div class="task-item" id="${taskId}">
                        <div class="row align-items-center">
                            <div class="col">
                                <input type="text" class="form-control task-input" placeholder="Enter task description..." data-id="${taskId}">
                            </div>
                            <div class="col-auto">
                                <button type="button" class="remove-btn remove-task" data-id="${taskId}">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
                $('#tasksContainer').append(taskHtml);
                updateTasksArray();
            });
            
            // Remove task
            $(document).on('click', '.remove-task', function() {
                const taskId = $(this).data('id');
                $('#' + taskId).remove();
                updateTasksArray();
            });
            
            // Update task input on change
            $(document).on('input', '.task-input', function() {
                updateTasksArray();
            });
            
            function updateTasksArray() {
                tasks.length = 0; // Clear array
                $('.task-input').each(function() {
                    const value = $(this).val().trim();
                    if (value) {
                        tasks.push(value);
                    }
                });
                $('#tasksInput').val(JSON.stringify(tasks));
            }
            
            // Medication management
            let medCounter = 0;
            const medications = [];
            
            $('#addMedicationBtn').click(function() {
                medCounter++;
                const medId = 'medication_' + medCounter;
                const medHtml = `
                    <div class="medication-item" id="${medId}">
                        <div class="row">
                            <div class="col-md-4 mb-2">
                                <input type="text" class="form-control medication-name" placeholder="Medication name" data-id="${medId}">
                            </div>
                            <div class="col-md-3 mb-2">
                                <input type="text" class="form-control medication-dosage" placeholder="Dosage (e.g., 10mg)" data-id="${medId}">
                            </div>
                            <div class="col-md-3 mb-2">
                                <input type="text" class="form-control medication-frequency" placeholder="Frequency (e.g., Daily)" data-id="${medId}">
                            </div>
                            <div class="col-md-2 mb-2 text-end">
                                <button type="button" class="remove-btn remove-medication" data-id="${medId}">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
                $('#medicationsContainer').append(medHtml);
                updateMedicationsArray();
            });
            
            // Remove medication
            $(document).on('click', '.remove-medication', function() {
                const medId = $(this).data('id');
                $('#' + medId).remove();
                updateMedicationsArray();
            });
            
            // Update medication input on change
            $(document).on('input', '.medication-name, .medication-dosage, .medication-frequency', function() {
                updateMedicationsArray();
            });
            
            function updateMedicationsArray() {
                medications.length = 0; // Clear array
                
                // Group medication fields
                const medItems = {};
                $('.medication-item').each(function() {
                    const medId = $(this).attr('id');
                    medItems[medId] = {
                        name: $(this).find('.medication-name').val().trim(),
                        dosage: $(this).find('.medication-dosage').val().trim(),
                        frequency: $(this).find('.medication-frequency').val().trim()
                    };
                });
                
                // Add non-empty medications to array
                for (const medId in medItems) {
                    const med = medItems[medId];
                    if (med.name || med.dosage || med.frequency) {
                        medications.push(med);
                    }
                }
                
                $('#medicationsInput').val(JSON.stringify(medications));
            }
            
            // File preview
            $('#attachments').on('change', function() {
                const files = $(this)[0].files;
                const filePreview = $('#filePreview');
                
                if (files.length > 0) {
                    filePreview.removeClass('d-none');
                    filePreview.empty();
                    
                    // Check file count
                    if (files.length > 5) {
                        filePreview.html(`
                            <div class="alert alert-danger">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                Maximum 5 files allowed. Please select fewer files.
                            </div>
                        `);
                        $(this).val('');
                        return;
                    }
                    
                    // Check file sizes and types
                    let validFiles = true;
                    const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
                    const maxSize = 5 * 1024 * 1024; // 5MB
                    
                    for (let i = 0; i < files.length; i++) {
                        const file = files[i];
                        
                        // Check file type
                        if (!allowedTypes.includes(file.type)) {
                            validFiles = false;
                            filePreview.html(`
                                <div class="alert alert-danger">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    File "${file.name}" has an invalid type. Only JPG, PNG, PDF, DOC, and DOCX files are allowed.
                                </div>
                            `);
                            $(this).val('');
                            break;
                        }
                        
                        // Check file size
                        if (file.size > maxSize) {
                            validFiles = false;
                            filePreview.html(`
                                <div class="alert alert-danger">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    File "${file.name}" is too large. Maximum file size is 5MB.
                                </div>
                            `);
                            $(this).val('');
                            break;
                        }
                    }
                    
                    if (validFiles) {
                        // Show file list
                        filePreview.html('<h6 class="mb-3">Selected Files:</h6>');
                        for (let i = 0; i < files.length; i++) {
                            const file = files[i];
                            const fileSize = (file.size / 1024 / 1024).toFixed(2); // MB
                            const fileItem = `
                                <div class="file-item">
                                    <i class="fas fa-file text-primary"></i>
                                    <span class="file-name">${file.name}</span>
                                    <small class="text-muted">${fileSize} MB</small>
                                </div>
                            `;
                            filePreview.append(fileItem);
                        }
                    }
                } else {
                    filePreview.addClass('d-none');
                }
            });
            
            // Form validation
            $('form.needs-validation').on('submit', function(event) {
                // Check if type is selected
                const typeSelected = $('input[name="type"]:checked').length > 0;
                if (!typeSelected) {
                    $('#typeError').show();
                    event.preventDefault();
                    event.stopPropagation();
                } else {
                    $('#typeError').hide();
                }
                
                // Check if tasks and medications are properly serialized
                updateTasksArray();
                updateMedicationsArray();
                
                // Check file count
                const files = $('#attachments')[0].files;
                if (files.length > 5) {
                    alert('Maximum 5 files allowed. Please select fewer files.');
                    event.preventDefault();
                    event.stopPropagation();
                }
                
                if (!this.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                
                $(this).addClass('was-validated');
            });
            
            // Show loading on submit
            $('form').on('submit', function() {
                const submitBtn = $(this).find('button[type="submit"]');
                const originalText = submitBtn.html();
                submitBtn.html('<i class="fas fa-spinner fa-spin me-2"></i>Saving...').prop('disabled', true);
                
                // Re-enable button after 10 seconds in case of error
                setTimeout(() => {
                    submitBtn.html(originalText).prop('disabled', false);
                }, 10000);
            });
            
            // Add one empty task and medication by default
            $('#addTaskBtn').click();
            $('#addMedicationBtn').click();
        });
    </script>
</body>
