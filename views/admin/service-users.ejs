<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manage Service Users || Care System Admin</title>
    
    <!-- favicons Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicons/favicon-16x16.png" />
    <link rel="manifest" href="/assets/images/favicons/site.webmanifest" />
    <meta name="description" content="Care System - Manage Service Users" />

    <!-- fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <!-- CSS libraries -->
    <link rel="stylesheet" href="/assets/vendors/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/assets/vendors/animate/animate.min.css" />
    <link rel="stylesheet" href="/assets/vendors/animate/custom-animate.css" />
    <link rel="stylesheet" href="/assets/vendors/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="/assets/vendors/jarallax/jarallax.css" />
    <link rel="stylesheet" href="/assets/vendors/jquery-magnific-popup/jquery.magnific-popup.css" />
    <link rel="stylesheet" href="/assets/vendors/nouislider/nouislider.min.css" />
    <link rel="stylesheet" href="/assets/vendors/nouislider/nouislider.pips.css" />
    <link rel="stylesheet" href="/assets/vendors/odometer/odometer.min.css" />
    <link rel="stylesheet" href="/assets/vendors/swiper/swiper.min.css" />
    <link rel="stylesheet" href="/assets/vendors/sominx-icons/style.css">
    <link rel="stylesheet" href="/assets/vendors/tiny-slider/tiny-slider.min.css" />
    <link rel="stylesheet" href="/assets/vendors/reey-font/stylesheet.css" />
    <link rel="stylesheet" href="/assets/vendors/owl-carousel/owl.carousel.min.css" />
    <link rel="stylesheet" href="/assets/vendors/owl-carousel/owl.theme.default.min.css" />
    <link rel="stylesheet" href="/assets/vendors/twentytwenty/twentytwenty.css" />
    <link rel="stylesheet" href="/assets/vendors/bxslider/jquery.bxslider.css" />
    <link rel="stylesheet" href="/assets/vendors/bootstrap-select/css/bootstrap-select.min.css" />
    <link rel="stylesheet" href="/assets/vendors/vegas/vegas.min.css" />
    <link rel="stylesheet" href="/assets/vendors/jquery-ui/jquery-ui.css" />
    <link rel="stylesheet" href="/assets/vendors/timepicker/timePicker.css" />

    <!-- template styles -->
    <link rel="stylesheet" href="/assets/css/sominx.css" />
    <link rel="stylesheet" href="/assets/css/sominx-responsive.css" />
    
    <!-- Custom Styles for Service Users Page -->
    <style>
        .service-users-header {
            background: #fff;
            border-radius: 10px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0px 10px 60px 0px rgba(0, 0, 0, 0.07);
        }
        
        .filter-card {
            background: #fff;
            border-radius: 10px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0px 10px 60px 0px rgba(0, 0, 0, 0.07);
        }
        
        .service-users-table-card {
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0px 10px 60px 0px rgba(0, 0, 0, 0.07);
            margin-bottom: 30px;
        }
        
        .service-user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }
        
        .service-user-avatar-sm {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 14px;
        }
        
        .status-badge {
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }
        
        .status-active {
            background: rgba(40, 167, 69, 0.1);
            color: #28a745;
        }
        
        .status-inactive {
            background: rgba(108, 117, 125, 0.1);
            color: #6c757d;
        }
        
        .status-pending {
            background: rgba(253, 126, 20, 0.1);
            color: #fd7e14;
        }
        
        .status-discharged {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }
        
        .care-level-badge {
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }
        
        .care-level-critical {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }
        
        .care-level-high {
            background: rgba(253, 126, 20, 0.1);
            color: #fd7e14;
        }
        
        .care-level-medium {
            background: rgba(23, 162, 184, 0.1);
            color: #17a2b8;
        }
        
        .care-level-low {
            background: rgba(40, 167, 69, 0.1);
            color: #28a745;
        }
        
        .support-worker-badge {
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            background: rgba(102, 126, 234, 0.1);
            color: #667eea;
        }
        
        .action-buttons {
            display: flex;
            gap: 8px;
        }
        
        .action-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            transition: all 0.3s ease;
        }
        
        .action-btn-view {
            background: rgba(102, 126, 234, 0.1);
            color: #667eea;
        }
        
        .action-btn-view:hover {
            background: #667eea;
            color: white;
        }
        
        .action-btn-edit {
            background: rgba(40, 167, 69, 0.1);
            color: #28a745;
        }
        
        .action-btn-edit:hover {
            background: #28a745;
            color: white;
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
        }
        
        .empty-state-icon {
            font-size: 60px;
            color: #e0e0e0;
            margin-bottom: 20px;
        }
        
        .table th {
            font-weight: 600;
            color: #213360;
            border-bottom: 2px solid #f0f0f0;
            padding: 20px 15px;
            background: #f9f9f9;
        }
        
        .table td {
            padding: 20px 15px;
            vertical-align: middle;
            border-bottom: 1px solid #f0f0f0;
        }
        
        .table tbody tr:hover {
            background: #f9f9f9;
        }
        
        .stat-card {
            background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
        }
        
        .stat-card h3 {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 5px;
        }
        
        .stat-card p {
            opacity: 0.9;
            margin-bottom: 0;
            font-size: 14px;
        }
        
        .form-control, .form-select {
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 10px 15px;
            height: 48px;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }
        
        .thm-btn {
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .contact-info {
            font-size: 13px;
            line-height: 1.4;
        }
        
        .service-user-id-badge {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 6px;
            padding: 3px 10px;
            font-size: 12px;
            font-weight: 600;
            color: #495057;
        }
        
        .age-badge {
            background: linear-gradient(45deg, #17a2b8 0%, #20c9d8 100%);
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
        }
    </style>
</head>

<body>
    <div class="preloader">
        <img class="preloader__image" width="60" src="/assets/images/loader.png" alt="" />
    </div>
    <!-- /.preloader -->
    
    <div class="page-wrapper">
        <!-- Header Start -->
        <header class="main-header clearfix">
            <nav class="main-menu clearfix">
                <div class="main-menu-wrapper clearfix">
                    <div class="main-menu-wrapper-inner clearfix">
                        <div class="main-menu-wrapper__left clearfix">
                            <div class="main-menu-wrapper__logo">
                                <a href="/"><img src="/assets/images/resources/logo-1.jpg" alt="Care System"></a>
                            </div>
                            <div class="main-menu-wrapper__main-menu">
                                <a href="#" class="mobile-nav__toggler"><i class="fa fa-bars"></i></a>
                                <ul class="main-menu__list">
                                    <li><a href="/admin/dashboard">Dashboard</a></li>
                                    <li class="dropdown current">
                                        <a href="#">Service Users</a>
                                        <ul>
                                            <li><a href="/service-users">All Service Users</a></li>
                                            <li><a href="/service-users/create">Add New Service User</a></li>
                                            <li><a href="/admin/service-users">Admin View</a></li>
                                        </ul>
                                    </li>
                                    <li class="dropdown">
                                        <a href="#">Support Workers</a>
                                        <ul>
                                            <li><a href="/admin/support-workers">Manage Support Workers</a></li>
                                            <li><a href="/admin/support-workers/create">Add Support Worker</a></li>
                                        </ul>
                                    </li>
                                    <li class="dropdown">
                                        <a href="#">Interactions</a>
                                        <ul>
                                            <li><a href="/interactions">All Interactions</a></li>
                                            <li><a href="/interactions/create">Log Interaction</a></li>
                                            <li><a href="/admin/interactions">Admin View</a></li>
                                        </ul>
                                    </li>
                                    <li><a href="/admin/reports">Reports</a></li>
                                    <li><a href="/admin/settings">Settings</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="main-menu-wrapper__right">
                            <div class="main-menu-wrapper__call">
                                <div class="main-menu-wrapper__call-icon">
                                    <span class="icon-phone-call"></span>
                                </div>
                                <div class="main-menu-wrapper__call-number">
                                    <p>Welcome back</p>
                                    <a href="/admin/profile"><%= user.fullName %></a>
                                </div>
                            </div>
                            <div class="main-menu-wrapper__search-box">
                                <a href="/logout" class="main-menu-wrapper__logout" title="Logout">
                                    <i class="fas fa-sign-out-alt"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
        <!-- Header End -->

        <div class="stricky-header stricked-menu main-menu">
            <div class="sticky-header__content"></div>
        </div>

        <!--Page Header Start-->
        <section class="page-header" style="background-image: url(/assets/images/backgrounds/page-header-bg.jpg);">
            <div class="container">
                <div class="page-header__inner">
                    <ul class="thm-breadcrumb list-unstyled">
                        <li><a href="/admin/dashboard">Dashboard</a></li>
                        <li><span>/</span></li>
                        <li>All Service Users</li>
                    </ul>
                    <h2>All Service Users</h2>
                </div>
            </div>
        </section>
        <!--Page Header End-->

        <!-- Service Users Content Start -->
        <section class="service-users-content pt-80 pb-120">
            <div class="container">
                <!-- Header with Stats -->
                <div class="service-users-header wow fadeInUp" data-wow-delay="100ms">
                    <div class="row align-items-center">
                        <div class="col-lg-8">
                            <h3 class="mb-3">
                                <i class="fas fa-user-friends text-primary me-2"></i>
                                Service User Management
                            </h3>
                            <p class="text-muted mb-0">Manage all service users in the system, view their details, and assign support workers.</p>
                        </div>
                        <div class="col-lg-4 text-lg-end">
                            <a href="/service-users/create" class="thm-btn">
                                <i class="fas fa-plus me-2"></i>Add New Service User
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Stats Cards -->
                <div class="row mb-5 wow fadeInUp" data-wow-delay="200ms">
                    <% 
                        const activeServiceUsers = serviceUsers.filter(c => c.status === 'active').length;
                        const inactiveServiceUsers = serviceUsers.filter(c => c.status === 'inactive').length;
                        const pendingServiceUsers = serviceUsers.filter(c => c.status === 'pending').length;
                        const criticalServiceUsers = serviceUsers.filter(c => c.careInfo?.careLevel === 'critical').length;
                    %>
                    <div class="col-xl-3 col-lg-6 col-md-6">
                        <div class="stat-card">
                            <h3><%= serviceUsers.length %></h3>
                            <p>Total Service Users</p>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-6 col-md-6">
                        <div class="stat-card" style="background: linear-gradient(45deg, #28a745 0%, #34d058 100%);">
                            <h3><%= activeServiceUsers %></h3>
                            <p>Active Service Users</p>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-6 col-md-6">
                        <div class="stat-card" style="background: linear-gradient(45deg, #fd7e14 0%, #ff9d42 100%);">
                            <h3><%= criticalServiceUsers %></h3>
                            <p>Critical Care Level</p>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-6 col-md-6">
                        <div class="stat-card" style="background: linear-gradient(45deg, #dc3545 0%, #ff6b6b 100%);">
                            <h3><%= pendingServiceUsers %></h3>
                            <p>Pending Status</p>
                        </div>
                    </div>
                </div>

                <!-- Filter Card -->
                <div class="filter-card wow fadeInUp" data-wow-delay="300ms">
                    <h5 class="mb-4">
                        <i class="fas fa-filter text-primary me-2"></i>
                        Filter Service Users
                    </h5>
                    <form method="GET" class="row g-3">
                        <div class="col-lg-4">
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0">
                                    <i class="fas fa-search text-muted"></i>
                                </span>
                                <input type="text" class="form-control border-start-0 ps-0" 
                                       name="search" placeholder="Search by name, ID, email or phone..." 
                                       value="<%= typeof search !== 'undefined' ? search : '' %>">
                            </div>
                        </div>
                        <div class="col-lg-2">
                            <select class="form-select" name="status">
                                <option value="all">All Status</option>
                                <option value="active" <%= (typeof status !== 'undefined' && status === 'active') ? 'selected' : '' %>>Active</option>
                                <option value="inactive" <%= (typeof status !== 'undefined' && status === 'inactive') ? 'selected' : '' %>>Inactive</option>
                                <option value="pending" <%= (typeof status !== 'undefined' && status === 'pending') ? 'selected' : '' %>>Pending</option>
                                <option value="discharged" <%= (typeof status !== 'undefined' && status === 'discharged') ? 'selected' : '' %>>Discharged</option>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <select class="form-select" name="support worker">
                                <option value="all">All Support Workers</option>
                                <% supportWorkers.forEach(op => { %>
                                    <option value="<%= op._id %>" 
                                            <%= (typeof supportWorker !== 'undefined' && supportWorker === op._id.toString()) ? 'selected' : '' %>>
                                        <%= op.firstName %> <%= op.lastName %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <select class="form-select" name="careLevel">
                                <option value="all">All Care Levels</option>
                                <option value="critical" <%= (typeof careLevel !== 'undefined' && careLevel === 'critical') ? 'selected' : '' %>>Critical</option>
                                <option value="high" <%= (typeof careLevel !== 'undefined' && careLevel === 'high') ? 'selected' : '' %>>High</option>
                                <option value="medium" <%= (typeof careLevel !== 'undefined' && careLevel === 'medium') ? 'selected' : '' %>>Medium</option>
                                <option value="low" <%= (typeof careLevel !== 'undefined' && careLevel === 'low') ? 'selected' : '' %>>Low</option>
                            </select>
                        </div>
                        <div class="col-lg-4 mt-3">
                            <button type="submit" class="thm-btn w-100">
                                <i class="fas fa-search me-2"></i>Apply Filters
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Service Users Table Card -->
                <div class="service-users-table-card wow fadeInUp" data-wow-delay="400ms">
                    <% if (serviceUsers.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Service User</th>
                                        <th>Contact</th>
                                        <th>Age</th>
                                        <th>Support Worker</th>
                                        <th>Care Level</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% serviceUsers.forEach(serviceUser => { %>
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="service-user-avatar me-3">
                                                        <%= serviceUser.firstName.charAt(0) %><%= serviceUser.lastName.charAt(0) %>
                                                    </div>
                                                    <div>
                                                        <h6 class="mb-1"><%= serviceUser.firstName %> <%= serviceUser.lastName %></h6>
                                                        <div class="service-user-id-badge d-inline-block">
                                                            ID: <%= serviceUser.referenceId || serviceUser._id.toString().slice(-6) %>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="contact-info">
                                                    <% if (serviceUser.contact?.email) { %>
                                                        <div class="mb-1">
                                                            <i class="fas fa-envelope text-primary me-2"></i>
                                                            <small><%= serviceUser.contact.email %></small>
                                                        </div>
                                                    <% } %>
                                                    <% if (serviceUser.contact?.phone?.primary) { %>
                                                        <div>
                                                            <i class="fas fa-phone text-primary me-2"></i>
                                                            <small><%= serviceUser.contact.phone.primary %></small>
                                                        </div>
                                                    <% } %>
                                                    <% if (!serviceUser.contact?.email && !serviceUser.contact?.phone?.primary) { %>
                                                        <small class="text-muted">No contact info</small>
                                                    <% } %>
                                                </div>
                                            </td>
                                            <td>
                                                <% if (serviceUser.age) { %>
                                                    <div class="age-badge">
                                                        <%= serviceUser.age %>
                                                    </div>
                                                <% } else if (serviceUser.dateOfBirth) { %>
                                                    <% const age = moment().diff(moment(serviceUser.dateOfBirth), 'years'); %>
                                                    <div class="age-badge">
                                                        <%= age %>
                                                    </div>
                                                <% } else { %>
                                                    <span class="text-muted">N/A</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (serviceUser.assignedSupportWorker) { %>
                                                    <span class="support-worker-badge">
                                                        <i class="fas fa-user-md me-1"></i>
                                                        <%= serviceUser.assignedSupportWorker.firstName %> <%= serviceUser.assignedSupportWorker.lastName %>
                                                    </span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary">Unassigned</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (serviceUser.careInfo?.careLevel) { %>
                                                    <span class="care-level-badge care-level-<%= serviceUser.careInfo.careLevel %>">
                                                        <i class="fas fa-<%= 
                                                            serviceUser.careInfo.careLevel === 'critical' ? 'exclamation-triangle' : 
                                                            serviceUser.careInfo.careLevel === 'high' ? 'thermometer-full' : 
                                                            serviceUser.careInfo.careLevel === 'medium' ? 'thermometer-half' : 'thermometer-empty' 
                                                        %> me-1"></i>
                                                        <%= serviceUser.careInfo.careLevel %>
                                                    </span>
                                                <% } else { %>
                                                    <span class="badge bg-light text-dark">Not set</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <span class="status-badge status-<%= serviceUser.status %>">
                                                    <i class="fas fa-<%= 
                                                        serviceUser.status === 'active' ? 'check-circle' : 
                                                        serviceUser.status === 'inactive' ? 'times-circle' : 
                                                        serviceUser.status === 'pending' ? 'clock' : 'sign-out-alt' 
                                                    %> me-1"></i>
                                                    <%= serviceUser.status %>
                                                </span>
                                            </td>
                                            <td>
                                                <div class="text-nowrap">
                                                    <div class="fw-medium"><%= moment(serviceUser.createdAt).format('MMM D, YYYY') %></div>
                                                    <small class="text-muted">by <%= serviceUser.createdBy?.firstName || 'System' %></small>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="action-buttons">
                                                    <a href="/admin/service-users/<%= serviceUser._id %>" 
                                                       class="action-btn action-btn-view" 
                                                       title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="/service-users/<%= serviceUser._id %>/edit" 
                                                       class="action-btn action-btn-edit" 
                                                       title="Edit Service User">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="empty-state">
                            <div class="empty-state-icon">
                                <i class="fas fa-user-friends"></i>
                            </div>
                            <h4 class="text-muted mb-3">No Service Users Found</h4>
                            <p class="text-muted mb-4">
                                <% if (typeof search !== 'undefined' && search) { %>
                                    No service users match your search criteria. Try a different search term.
                                <% } else if (typeof status !== 'undefined' && status !== 'all') { %>
                                    No service users found with the selected status.
                                <% } else if (typeof supportWorker !== 'undefined' && supportWorker !== 'all') { %>
                                    No service users assigned to the selected support worker.
                                <% } else if (typeof careLevel !== 'undefined' && careLevel !== 'all') { %>
                                    No service users found with the selected care level.
                                <% } else { %>
                                    You haven't added any service users yet.
                                <% } %>
                            </p>
                            <a href="/service-users/create" class="thm-btn">
                                <i class="fas fa-plus me-2"></i>Add Your First Service User
                            </a>
                        </div>
                    <% } %>
                </div>

                <!-- Pagination or Info -->
                <% if (serviceUsers.length > 0) { %>
