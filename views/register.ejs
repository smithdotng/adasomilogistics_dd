                        <div class="form-row">
                            <div class="form-group">
                                <label for="insurancePolicyNumber">Policy Number</label>
                                <input type="text" class="form-control" id="insurancePolicyNumber" name="insurancePolicyNumber" 
                                       placeholder="Policy number">
