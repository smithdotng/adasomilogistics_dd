<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'Available Deliveries' }) %>
</head>
<body>
<%- include('../partials/header') %>
<%- include('../partials/flash') %>

<main class="page-shell">
    <div class="container">
        <p class="section-title mb-1">Dispatch Pool</p>
        <h2 class="mb-4">Available Deliveries</h2>

        <% if (!orders.length) { %>
            <div class="empty-state"><i class="fa-solid fa-inbox"></i><p>No deliveries available right now. Check back soon.</p></div>
        <% } else { %>
        <div class="row g-4">
            <% orders.forEach(function(o) { %>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <strong><%= o.orderNumber %></strong>
                            <span class="badge-pill status-<%= o.type %>"><%= o.type %></span>
                        </div>
                        <p class="mb-1 small"><i class="fa-solid fa-circle text-success me-1"></i><%= o.pickupAddress %></p>
                        <p class="mb-2 small"><i class="fa-solid fa-circle text-danger me-1"></i><%= o.dropoffAddress %></p>
                        <p class="mb-3 text-muted small"><%= o.distanceKm %> km &middot; <%= o.merchant ? (o.merchant.merchantInfo ? o.merchant.merchantInfo.businessName : o.merchant.fullName) : 'Public request' %></p>
                        <div class="d-flex justify-content-between align-items-center">
                            <strong>₦<%= o.pricing.riderPayout.toLocaleString() %> <span class="text-muted fw-normal small">payout</span></strong>
                            <form action="/rider/orders/<%= o._id %>/accept" method="POST">
                                <button class="btn btn-peach btn-sm">Accept</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
        <% } %>
    </div>
</main>
<%- include('../partials/footer') %>
</body>
</html>
