    <!-- Page Header -->
    <section class="page-header">
        <div class="container">
            <h1>Powerful Features for Modern Care</h1>
            <p>Everything you need to manage your care business efficiently, from staff scheduling to CQC compliance.</p>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Features</li>
                </ol>
            </nav>
        </div>
    </section>

    <!-- Features Grid -->
    <section class="features-grid-section">
        <div class="container">
            <!-- Feature 1 -->
            <div class="feature-item row align-items-center">
                <div class="col-lg-6">
                    <div class="feature-icon-large">
                        <i class="fas fa-building"></i>
                    </div>
                    <div class="feature-content">
                        <h2>Multi-Provider Management</h2>
                        <p>Manage multiple care locations and services from a single, unified dashboard. Perfect for growing care groups and franchises.</p>
                        <ul class="feature-list">
                            <li><i class="fas fa-check"></i> Multiple locations</li>
                            <li><i class="fas fa-check"></i> Centralised control</li>
                            <li><i class="fas fa-check"></i> Role-based access</li>
                            <li><i class="fas fa-check"></i> Cross-location reporting</li>
                            <li><i class="fas fa-check"></i> Scalable architecture</li>
                            <li><i class="fas fa-check"></i> Brand customisation</li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="feature-image">
                        <img src="/assets/images/feature-multi-provider.jpg" alt="Multi-Provider Management" class="img-fluid">
                    </div>
