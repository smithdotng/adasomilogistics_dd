                        </div>

                        <h4 class="mt-4 mb-3">Data Protection</h4>

                        <div class="checkbox-group">
                            <input type="checkbox" id="dataProtection" name="dataProtection" required>
                            <label for="dataProtection">I confirm that we are registered with the ICO (Information Commissioner's Office) <span class="required">*</span></label>
                        </div>
                        <div class="error-message" id="dataProtectionError">You must confirm ICO registration</div>

                        <div class="form-group mt-3">
                            <label for="icoNumber">ICO Registration Number</label>
                            <input type="text" class="form-control" id="icoNumber" name="icoNumber" 
                                   placeholder="e.g., ZA123456">
                        </div>
                    </div>

                    <!-- Section 4: Subscription & Confirmation -->
                    <div class="form-section" id="section4">
                        <h3 class="section-title">
                            <i class="fas fa-credit-card me-2" style="color: var(--thm-primary);"></i>
                            Subscription & Confirmation
                        </h3>

                        <div class="info-box">
                            <h4><i class="fas fa-gift me-2"></i>14-Day Free Trial</h4>
                            <p>Start with a 14-day free trial on our Professional plan. No credit card required.</p>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="pricing-card" style="border: 2px solid var(--thm-primary); padding: 30px; border-radius: 10px;">
                                    <h4>Professional Plan</h4>
                                    <h2 style="color: var(--thm-primary);">£99<span style="font-size: 16px; color: #6c6c6c;">/month</span></h2>
                                    <p class="text-success"><i class="fas fa-check-circle"></i> 14-day free trial</p>
                                    <ul style="list-style: none; padding: 0;">
