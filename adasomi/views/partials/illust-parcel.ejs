<div class="illust-banner">
<svg viewBox="0 0 400 150" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" role="img" aria-label="Parcel with a location pin, ready for pickup">
    <rect width="400" height="150" fill="#e9f2fd"/>
    <rect x="0" y="118" width="400" height="32" fill="#cfe3fa"/>

    <!-- parcel box -->
    <g transform="translate(140,45)">
        <rect x="0" y="20" width="110" height="75" rx="6" fill="#ffffff" stroke="#8fc3ff" stroke-width="5"/>
        <path d="M0 45 H110" stroke="#8fc3ff" stroke-width="5"/>
        <path d="M55 20 V95" stroke="#8fc3ff" stroke-width="5"/>
        <path d="M35 20 L55 45 L75 20" fill="#2f7dd8"/>
    </g>

    <!-- location pin -->
    <g transform="translate(275,15)">
        <path d="M25 0 C10 0 0 11 0 25 C0 43 25 65 25 65 C25 65 50 43 50 25 C50 11 40 0 25 0 Z" fill="#2f7dd8"/>
        <circle cx="25" cy="24" r="10" fill="#ffffff"/>
    </g>

    <!-- dotted route -->
    <path d="M60 110 Q160 130 275 60" stroke="#1c5aa8" stroke-width="3" stroke-dasharray="2 10" stroke-linecap="round" fill="none"/>
</svg>
</div>
