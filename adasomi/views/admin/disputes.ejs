<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'Disputes' }) %>
</head>
<body>
<%- include('../partials/header') %>
<%- include('../partials/flash') %>

<main class="page-shell">
    <div class="container">
        <p class="section-title mb-1">Resolution Center</p>
        <h2 class="mb-4">Disputes</h2>

        <div class="card">
            <div class="card-body">
                <% if (!disputes.length) { %>
                    <div class="empty-state"><i class="fa-solid fa-handshake"></i><p>No disputes have been raised.</p></div>
                <% } else { %>
                <% disputes.forEach(function(d) { %>
                <div class="border-bottom pb-3 mb-3">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <strong><%= d.order ? d.order.orderNumber : 'Order removed' %></strong>
                            <span class="badge-pill status-<%= d.status %> ms-2"><%= d.status %></span>
                            <p class="text-muted small mb-1 mt-1">Raised by <%= d.raisedBy ? d.raisedBy.fullName : 'Unknown' %> · <%= moment(d.createdAt).fromNow() %></p>
                            <p class="mb-0"><%= d.reason %></p>
                            <% if (d.resolutionNotes) { %><p class="text-muted small mt-1">Resolution: <%= d.resolutionNotes %></p><% } %>
                        </div>
                        <% if (['open','investigating'].includes(d.status)) { %>
                        <form action="/admin/disputes/resolve" method="POST" class="d-flex gap-2 flex-wrap" style="min-width:280px;">
                            <input type="hidden" name="disputeId" value="<%= d._id %>">
                            <input type="text" class="form-control form-control-sm" name="resolutionNotes" placeholder="Resolution notes">
                            <button class="btn btn-peach btn-sm" name="decision" value="resolve">Resolve</button>
                            <button class="btn btn-danger-soft btn-sm" name="decision" value="reject">Reject</button>
                        </form>
                        <% } %>
                    </div>
                </div>
                <% }) %>
                <% } %>
            </div>
        </div>
    </div>
</main>
<%- include('../partials/footer') %>
</body>
</html>
