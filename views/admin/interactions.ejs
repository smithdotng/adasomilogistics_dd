    <!-- Custom Styles for Interactions Page -->
    <style>
        .interactions-header {
            background: #fff;
            border-radius: 10px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0px 10px 60px 0px rgba(0, 0, 0, 0.07);
        }
        
        .filter-card {
            background: #fff;
            border-radius: 10px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0px 10px 60px 0px rgba(0, 0, 0, 0.07);
        }
        
        .interactions-table-card {
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0px 10px 60px 0px rgba(0, 0, 0, 0.07);
            margin-bottom: 30px;
        }
        
        .interaction-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }
        
        .interaction-avatar-sm {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 14px;
        }
        
        .type-badge {
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }
        
        .type-visit {
            background: rgba(102, 126, 234, 0.1);
            color: #667eea;
        }
        
        .type-phone_call {
            background: rgba(40, 167, 69, 0.1);
            color: #28a745;
        }
        
        .type-video_call {
            background: rgba(23, 162, 184, 0.1);
            color: #17a2b8;
        }
        
        .type-emergency {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }
        
        .type-medication {
            background: rgba(253, 126, 20, 0.1);
            color: #fd7e14;
        }
        
        .type-assessment {
            background: rgba(111, 66, 193, 0.1);
            color: #6f42c1;
        }
        
        .status-badge {
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }
        
        .status-completed {
            background: rgba(40, 167, 69, 0.1);
            color: #28a745;
        }
        
        .status-in_progress {
            background: rgba(23, 162, 184, 0.1);
            color: #17a2b8;
        }
        
        .status-draft {
            background: rgba(108, 117, 125, 0.1);
            color: #6c757d;
        }
        
        .status-cancelled {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }
        
        .operator-badge {
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            background: rgba(102, 126, 234, 0.1);
            color: #667eea;
        }
        
        .client-badge {
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            background: rgba(40, 167, 69, 0.1);
            color: #28a745;
        }
        
        .action-buttons {
            display: flex;
            gap: 8px;
        }
        
        .action-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            transition: all 0.3s ease;
        }
        
        .action-btn-view {
            background: rgba(102, 126, 234, 0.1);
            color: #667eea;
        }
        
        .action-btn-view:hover {
            background: #667eea;
            color: white;
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
        }
        
        .empty-state-icon {
            font-size: 60px;
            color: #e0e0e0;
            margin-bottom: 20px;
        }
        
        .table th {
            font-weight: 600;
            color: #213360;
            border-bottom: 2px solid #f0f0f0;
            padding: 20px 15px;
            background: #f9f9f9;
        }
        
        .table td {
            padding: 20px 15px;
            vertical-align: middle;
            border-bottom: 1px solid #f0f0f0;
        }
        
        .table tbody tr:hover {
            background: #f9f9f9;
        }
        
        .stat-card {
            background: linear-gradient(45deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
        }
        
        .stat-card h3 {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 5px;
        }
        
        .stat-card p {
            opacity: 0.9;
            margin-bottom: 0;
            font-size: 14px;
        }
        
        .form-control, .form-select {
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 10px 15px;
            height: 48px;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }
        
        .thm-btn {
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .duration-badge {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 6px;
            padding: 3px 10px;
            font-size: 12px;
            font-weight: 600;
            color: #495057;
            text-align: center;
        }
        
        .time-cell {
            min-width: 140px;
        }
        
        .date-display {
            font-weight: 600;
            color: #213360;
        }
        
        .time-display {
            font-size: 12px;
            color: #6c757d;
        }
    </style>
</head>

