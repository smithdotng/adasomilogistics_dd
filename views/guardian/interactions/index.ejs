<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Service User Interactions || Care System Guardian</title>
    
    <!-- Include all the same CSS and JS as guardian dashboard -->
    <!-- favicons Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/images/favicons/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicons/favicon-16x16.png" />
    <link rel="manifest" href="/assets/images/favicons/site.webmanifest" />
    <meta name="description" content="Care System - Guardian Interactions" />

    <!-- fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <!-- CSS libraries -->
    <link rel="stylesheet" href="/assets/vendors/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/assets/vendors/animate/animate.min.css" />
    <link rel="stylesheet" href="/assets/vendors/animate/custom-animate.css" />
    <link rel="stylesheet" href="/assets/vendors/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="/assets/vendors/jarallax/jarallax.css" />
    <link rel="stylesheet" href="/assets/vendors/jquery-magnific-popup/jquery.magnific-popup.css" />
    <link rel="stylesheet" href="/assets/vendors/nouislider/nouislider.min.css" />
    <link rel="stylesheet" href="/assets/vendors/nouislider/nouislider.pips.css" />
    <link rel="stylesheet" href="/assets/vendors/odometer/odometer.min.css" />
    <link rel="stylesheet" href="/assets/vendors/swiper/swiper.min.css" />
    <link rel="stylesheet" href="/assets/vendors/sominx-icons/style.css">
    <link rel="stylesheet" href="/assets/vendors/tiny-slider/tiny-slider.min.css" />
    <link rel="stylesheet" href="/assets/vendors/reey-font/stylesheet.css" />
    <link rel="stylesheet" href="/assets/vendors/owl-carousel/owl.carousel.min.css" />
    <link rel="stylesheet" href="/assets/vendors/owl-carousel/owl.theme.default.min.css" />
    <link rel="stylesheet" href="/assets/vendors/twentytwenty/twentytwenty.css" />
    <link rel="stylesheet" href="/assets/vendors/bxslider/jquery.bxslider.css" />
    <link rel="stylesheet" href="/assets/vendors/bootstrap-select/css/bootstrap-select.min.css" />
    <link rel="stylesheet" href="/assets/vendors/vegas/vegas.min.css" />
    <link rel="stylesheet" href="/assets/vendors/jquery-ui/jquery-ui.css" />
    <link rel="stylesheet" href="/assets/vendors/timepicker/timePicker.css" />

    <!-- template styles -->
    <link rel="stylesheet" href="/assets/css/sominx.css" />
    <link rel="stylesheet" href="/assets/css/sominx-responsive.css" />
    
    <!-- Guardian Interaction Styles -->
    <style>
        :root {
            --guardian-primary: #4a8b8f;
            --guardian-secondary: #f5a623;
            --guardian-accent: #7b68ee;
        }
        
        .interactions-header {
            background: #fff;
            border-radius: 10px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0px 10px 60px 0px rgba(0, 0, 0, 0.07);
        }
        
        .filter-card {
            background: #fff;
            border-radius: 10px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0px 10px 60px 0px rgba(0, 0, 0, 0.07);
        }
        
        .interactions-table-card {
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0px 10px 60px 0px rgba(0, 0, 0, 0.07);
            margin-bottom: 30px;
        }
        
        .type-badge {
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }
        
        .type-visit {
            background: rgba(102, 126, 234, 0.1);
            color: #667eea;
        }
        
        .type-phone_call {
            background: rgba(40, 167, 69, 0.1);
            color: #28a745;
        }
        
        .type-video_call {
            background: rgba(23, 162, 184, 0.1);
            color: #17a2b8;
        }
        
        .type-emergency {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }
        
        .type-medication {
            background: rgba(253, 126, 20, 0.1);
            color: #fd7e14;
        }
        
        .type-family_meeting {
            background: rgba(111, 66, 193, 0.1);
            color: #6f42c1;
        }
        
        .status-badge {
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }
        
        .status-completed {
            background: rgba(40, 167, 69, 0.1);
            color: #28a745;
        }
        
        .status-in_progress {
            background: rgba(23, 162, 184, 0.1);
            color: #17a2b8;
        }
        
        .status-draft {
            background: rgba(108, 117, 125, 0.1);
            color: #6c757d;
        }
        
        .status-cancelled {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }
        
        .action-buttons {
            display: flex;
            gap: 8px;
        }
        
        .action-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            transition: all 0.3s ease;
        }
        
        .action-btn-view {
            background: rgba(102, 126, 234, 0.1);
            color: #667eea;
        }
        
        .action-btn-view:hover {
            background: #667eea;
            color: white;
        }
        
        .action-btn-edit {
            background: rgba(253, 126, 20, 0.1);
            color: #fd7e14;
        }
        
        .action-btn-edit:hover {
            background: #fd7e14;
            color: white;
        }
        
        .action-btn-delete {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }
        
        .action-btn-delete:hover {
            background: #dc3545;
            color: white;
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
        }
        
        .empty-state-icon {
            font-size: 60px;
            color: #e0e0e0;
            margin-bottom: 20px;
        }
        
        .table th {
            font-weight: 600;
            color: #213360;
            border-bottom: 2px solid #f0f0f0;
            padding: 20px 15px;
            background: #f9f9f9;
        }
        
        .table td {
            padding: 20px 15px;
            vertical-align: middle;
            border-bottom: 1px solid #f0f0f0;
        }
        
        .table tbody tr:hover {
            background: #f9f9f9;
        }
        
        .stat-card {
            background: linear-gradient(45deg, var(--guardian-primary) 0%, #6bc4c9 100%);
            color: white;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
        }
        
        .stat-card h3 {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 5px;
        }
        
        .stat-card p {
            opacity: 0.9;
            margin-bottom: 0;
            font-size: 14px;
        }
        
        .form-control, .form-select {
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 10px 15px;
            height: 48px;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: var(--guardian-primary);
            box-shadow: 0 0 0 0.2rem rgba(74, 139, 143, 0.25);
        }
        
        .thm-btn {
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        
        .duration-badge {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 6px;
            padding: 3px 10px;
            font-size: 12px;
            font-weight: 600;
            color: #495057;
            text-align: center;
        }
        
        .time-cell {
            min-width: 140px;
        }
        
        .date-display {
            font-weight: 600;
            color: #213360;
        }
        
        .time-display {
            font-size: 12px;
            color: #6c757d;
        }
        
        .service-user-badge {
            display: inline-block;
            background: rgba(74, 139, 143, 0.1);
            color: var(--guardian-primary);
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
        }
        
        .additional-actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }
        
        .additional-btn {
            padding: 8px 20px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .additional-btn.calendar {
            background: rgba(74, 139, 143, 0.1);
            color: var(--guardian-primary);
            border: 1px solid var(--guardian-primary);
        }
        
        .additional-btn.export {
            background: rgba(111, 66, 193, 0.1);
            color: #6f42c1;
            border: 1px solid #6f42c1;
        }
        
        .additional-btn:hover {
            opacity: 0.9;
        }
    </style>
</head>

<body>
    <div class="preloader">
        <img class="preloader__image" width="60" src="/assets/images/loader.png" alt="" />
    </div>
    <!-- /.preloader -->
    
    <div class="page-wrapper">
        <!-- Header Start -->
        <header class="main-header clearfix">
            <nav class="main-menu clearfix">
                <div class="main-menu-wrapper clearfix">
                    <div class="main-menu-wrapper-inner clearfix">
                        <div class="main-menu-wrapper__left clearfix">
                            <div class="main-menu-wrapper__logo">
                                <a href="/"><img src="/assets/images/resources/logo-1.jpg" alt="Care System"></a>
                            </div>
                            <div class="main-menu-wrapper__main-menu">
                                <a href="#" class="mobile-nav__toggler"><i class="fa fa-bars"></i></a>
                                <ul class="main-menu__list">
                                    <li><a href="/guardian/dashboard">Dashboard</a></li>
                                    <li><a href="/guardian/service-user">Service User Information</a></li>
                                    <li class="current"><a href="/guardian/interactions">Interactions</a></li>
                                    <li><a href="/guardian/documents">Documents</a></li>
                                    <li><a href="/guardian/change-password">Settings</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="main-menu-wrapper__right">
                            <div class="main-menu-wrapper__call">
                                <div class="main-menu-wrapper__call-icon">
                                    <span class="icon-user-check"></span>
                                </div>
                                <div class="main-menu-wrapper__call-number">
                                    <p>Welcome back</p>
                                    <a href="/guardian/change-password"><%= user.fullName %></a>
                                </div>
                            </div>
                            <div class="main-menu-wrapper__search-box">
                                <a href="/logout" class="main-menu-wrapper__logout" title="Logout">
                                    <i class="fas fa-sign-out-alt"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
        <!-- Header End -->

        <div class="stricky-header stricked-menu main-menu">
            <div class="sticky-header__content"></div>
        </div>

        <!--Page Header Start-->
        <section class="page-header" style="padding: 60px 0 40px;">
            <div class="container">
                <div class="page-header__inner">
                    <div class="service-user-badge">
                        <i class="fas fa-user me-2"></i>
                        <%= serviceUser.firstName %> <%= serviceUser.lastName %>
                    </div>
                    <h2>Service User Interactions</h2>
                </div>
            </div>
        </section>
        <!--Page Header End-->

        <!-- Interactions Content Start -->
        <section class="interactions-content pt-80 pb-120">
            <div class="container">
                <!-- Header with Stats -->
                <div class="interactions-header wow fadeInUp" data-wow-delay="100ms">
                    <div class="row align-items-center">
                        <div class="col-lg-8">
                            <h3 class="mb-3">
                                <i class="fas fa-history text-primary me-2"></i>
                                Interaction History
                            </h3>
                            <p class="text-muted mb-0">
                                View and manage interactions for <%= serviceUser.firstName %> <%= serviceUser.lastName %>.
                                You can log new interactions, view details, and track care activities.
                            </p>
                        </div>
                        <div class="col-lg-4 text-lg-end">
                            <a href="/guardian/interactions/create" class="thm-btn">
                                <i class="fas fa-plus me-2"></i>Log New Interaction
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Stats Cards -->
                <div class="row mb-5 wow fadeInUp" data-wow-delay="200ms">
                    <div class="col-xl-3 col-lg-6 col-md-6">
                        <div class="stat-card">
                            <h3><%= interactions.length %></h3>
                            <p>Total Interactions</p>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-6 col-md-6">
                        <div class="stat-card" style="background: linear-gradient(45deg, #28a745 0%, #34d058 100%);">
                            <h3><%= completedInteractions %></h3>
                            <p>Completed</p>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-6 col-md-6">
                        <div class="stat-card" style="background: linear-gradient(45deg, #fd7e14 0%, #ff9d42 100%);">
                            <h3><%= emergencyInteractions %></h3>
                            <p>Emergency Cases</p>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-6 col-md-6">
                        <div class="stat-card" style="background: linear-gradient(45deg, #17a2b8 0%, #20c9d8 100%);">
                            <h3><%= thisWeekInteractions %></h3>
                            <p>This Week</p>
                        </div>
                    </div>
                </div>

                <!-- Filter Card -->
                <div class="filter-card wow fadeInUp" data-wow-delay="300ms">
                    <h5 class="mb-4">
                        <i class="fas fa-filter text-primary me-2"></i>
                        Filter Interactions
                    </h5>
                    <form method="GET" action="/guardian/interactions" class="row g-3">
                        <div class="col-lg-3">
                            <select class="form-select" name="type">
                                <option value="all">All Types</option>
                                <option value="visit" <%= (typeof type !== 'undefined' && type === 'visit') ? 'selected' : '' %>>Visit</option>
                                <option value="phone_call" <%= (typeof type !== 'undefined' && type === 'phone_call') ? 'selected' : '' %>>Phone Call</option>
                                <option value="video_call" <%= (typeof type !== 'undefined' && type === 'video_call') ? 'selected' : '' %>>Video Call</option>
                                <option value="emergency" <%= (typeof type !== 'undefined' && type === 'emergency') ? 'selected' : '' %>>Emergency</option>
                                <option value="medication" <%= (typeof type !== 'undefined' && type === 'medication') ? 'selected' : '' %>>Medication</option>
                                <option value="family_meeting" <%= (typeof type !== 'undefined' && type === 'family_meeting') ? 'selected' : '' %>>Family Meeting</option>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <select class="form-select" name="status">
                                <option value="all">All Status</option>
                                <option value="completed" <%= (typeof status !== 'undefined' && status === 'completed') ? 'selected' : '' %>>Completed</option>
                                <option value="in_progress" <%= (typeof status !== 'undefined' && status === 'in_progress') ? 'selected' : '' %>>In Progress</option>
                                <option value="draft" <%= (typeof status !== 'undefined' && status === 'draft') ? 'selected' : '' %>>Draft</option>
                                <option value="cancelled" <%= (typeof status !== 'undefined' && status === 'cancelled') ? 'selected' : '' %>>Cancelled</option>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <label class="form-label">Date Range</label>
                            <div class="input-group">
                                <input type="date" class="form-control" name="startDate" 
                                       value="<%= typeof startDate !== 'undefined' ? startDate : '' %>" placeholder="Start Date">
                                <span class="input-group-text bg-light border-0">to</span>
                                <input type="date" class="form-control" name="endDate" 
                                       value="<%= typeof endDate !== 'undefined' ? endDate : '' %>" placeholder="End Date">
                            </div>
                        </div>
                        <div class="col-lg-3 d-flex align-items-end">
                            <button type="submit" class="thm-btn w-100">
                                <i class="fas fa-filter me-2"></i>Apply Filters
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Additional Actions -->
                <div class="additional-actions wow fadeInUp" data-wow-delay="350ms">
                    <a href="/guardian/interactions/calendar" class="additional-btn calendar">
                        <i class="fas fa-calendar-alt"></i>Calendar View
                    </a>
                    <a href="/guardian/interactions/export" class="additional-btn export">
                        <i class="fas fa-download"></i>Export to CSV
                    </a>
                </div>

                <!-- Interactions Table Card -->
                <div class="interactions-table-card wow fadeInUp" data-wow-delay="400ms">
                    <% if (interactions.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="time-cell">Date & Time</th>
                                        <th>Interaction</th>
                                        <th>Type</th>
                                        <th>Support Worker</th>
                                        <th>Duration</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% interactions.forEach(function(interaction) { %>
                                        <tr>
                                            <td class="time-cell">
                                                <div class="date-display"><%= moment(interaction.startTime).format('MMM D, YYYY') %></div>
                                                <div class="time-display"><%= moment(interaction.startTime).format('h:mm A') %></div>
                                            </td>
                                            <td>
                                                <h6 class="mb-1"><%= interaction.title %></h6>
                                                <small class="text-muted">
                                                    <% if (interaction.description && interaction.description.length > 80) { %>
                                                        <%= interaction.description.substring(0, 80) %>...
                                                    <% } else { %>
                                                        <%= interaction.description || 'No description' %>
                                                    <% } %>
                                                </small>
                                            </td>
                                            <td>
                                                <%
                                                    let typeIcon = 'clipboard';
                                                    if (interaction.type === 'visit') typeIcon = 'home';
                                                    else if (interaction.type === 'phone_call') typeIcon = 'phone';
                                                    else if (interaction.type === 'video_call') typeIcon = 'video';
                                                    else if (interaction.type === 'emergency') typeIcon = 'exclamation-triangle';
                                                    else if (interaction.type === 'medication') typeIcon = 'pills';
                                                    else if (interaction.type === 'family_meeting') typeIcon = 'users';
                                                %>
                                                <span class="type-badge type-<%= interaction.type %>">
                                                    <i class="fas fa-<%= typeIcon %> me-1"></i>
                                                    <%= interaction.type.replace('_', ' ') %>
                                                </span>
                                            </td>
                                            <td>
                                                <% if (interaction.supportWorker) { %>
                                                    <%= interaction.supportWorker.firstName %> <%= interaction.supportWorker.lastName %>
                                                <% } else { %>
                                                    <span class="text-muted">Not assigned</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% 
                                                    let durationText = 'N/A';
                                                    if (interaction.duration) {
                                                        let durationHtml = '';
                                                        if (interaction.duration.hours > 0) {
                                                            durationHtml += interaction.duration.hours + 'h ';
                                                        }
                                                        durationHtml += interaction.duration.minutes + 'm';
                                                        durationText = durationHtml;
                                                    } else if (interaction.endTime) {
                                                        const start = new Date(interaction.startTime);
                                                        const end = new Date(interaction.endTime);
                                                        const durationMs = end - start;
                                                        const hours = Math.floor(durationMs / (1000 * 60 * 60));
                                                        const minutes = Math.floor((durationMs % (1000 * 60 * 60)) / (1000 * 60));
                                                        
                                                        let durationHtml = '';
                                                        if (hours > 0) {
                                                            durationHtml += hours + 'h ';
                                                        }
                                                        durationHtml += minutes + 'm';
                                                        durationText = durationHtml;
                                                    }
                                                %>
                                                <% if (durationText !== 'N/A') { %>
                                                    <div class="duration-badge">
                                                        <%= durationText %>
                                                    </div>
                                                <% } else { %>
                                                    <span class="text-muted">N/A</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <%
                                                    let statusIcon = 'check-circle';
                                                    if (interaction.status === 'in_progress') statusIcon = 'sync-alt';
                                                    else if (interaction.status === 'draft') statusIcon = 'edit';
                                                    else if (interaction.status === 'cancelled') statusIcon = 'times-circle';
                                                %>
                                                <span class="status-badge status-<%= interaction.status %>">
                                                    <i class="fas fa-<%= statusIcon %> me-1"></i>
                                                    <%= interaction.status.replace('_', ' ') %>
                                                </span>
                                            </td>
                                            <td>
                                                <div class="action-buttons">
                                                    <a href="/guardian/interactions/<%= interaction._id %>" 
                                                       class="action-btn action-btn-view" 
                                                       title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <% if (interaction.supportWorker && interaction.supportWorker._id.toString() === user.id && interaction.status === 'draft') { %>
                                                        <a href="/guardian/interactions/<%= interaction._id %>/edit" 
                                                           class="action-btn action-btn-edit" 
                                                           title="Edit Interaction">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                        <form action="/guardian/interactions/<%= interaction._id %>?_method=DELETE" 
                                                              method="POST" 
                                                              class="d-inline"
                                                              onsubmit="return confirm('Are you sure you want to delete this interaction?');">
                                                            <button type="submit" class="action-btn action-btn-delete" title="Delete Interaction">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </form>
                                                    <% } %>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="empty-state">
                            <div class="empty-state-icon">
                                <i class="fas fa-clipboard-list"></i>
                            </div>
                            <h4 class="text-muted mb-3">No Interactions Found</h4>
                            <p class="text-muted mb-4">
                                <% 
                                    let message = "No interactions have been logged for " + serviceUser.firstName + " yet.";
                                    if (typeof type !== 'undefined' && type !== 'all') {
                                        message = "No " + type.replace('_', ' ') + " interactions found.";
                                    } else if (typeof status !== 'undefined' && status !== 'all') {
                                        message = "No " + status.replace('_', ' ') + " interactions found.";
                                    } else if ((typeof startDate !== 'undefined' && startDate) || (typeof endDate !== 'undefined' && endDate)) {
                                        message = "No interactions found within the selected date range.";
                                    }
                                %>
                                <%= message %>
                            </p>
                            <a href="/guardian/interactions/create" class="thm-btn">
                                <i class="fas fa-plus me-2"></i>Log Your First Interaction
                            </a>
                        </div>
                    <% } %>
                </div>

                <!-- Pagination or Info -->
