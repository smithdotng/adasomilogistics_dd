                                        <li><i class="fas fa-check me-2" style="color: var(--thm-primary);"></i>Up to 100 clients</li>
                                        <li><i class="fas fa-check me-2" style="color: var(--thm-primary);"></i>Advanced scheduling</li>
                                        <li><i class="fas fa-check me-2" style="color: var(--thm-primary);"></i>Medication management</li>
                                        <li><i class="fas fa-check me-2" style="color: var(--thm-primary);"></i>Guardian portal</li>
