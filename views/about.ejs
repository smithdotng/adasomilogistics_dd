    <script>
        $(document).ready(function() {
            // Header scroll effect
            $(window).scroll(function() {
                if ($(this).scrollTop() > 100) {
                    $('#mainHeader').addClass('scrolled');
                } else {
                    $('#mainHeader').removeClass('scrolled');
                }
            });

            // Mobile menu toggle
            $('#mobileToggler').click(function(e) {
                e.preventDefault();
                $('#mobileMenu').addClass('open');
            });

            $('#mobileClose').click(function(e) {
                e.preventDefault();
                $('#mobileMenu').removeClass('open');
            });

            // Close mobile menu when clicking a link
            $('.mobile-menu-links a').click(function() {
                $('#mobileMenu').removeClass('open');
            });

            // Counter animation
            function animateCounter() {
                $('.counter').each(function() {
                    const $this = $(this);
                    const target = parseInt($this.data('target'));
                    
                    $({ count: 0 }).animate({ count: target }, {
                        duration: 2000,
                        easing: 'swing',
                        step: function() {
                            const num = Math.floor(this.count);
                            $this.text(num.toLocaleString());
                        },
                        complete: function() {
                            $this.text(target.toLocaleString() + (target === 46.2 ? 'B' : target === 23 ? '%' : ''));
                        }
                    });
                });
            }

            // Trigger counter animation when element is in viewport
            const statsSection = document.querySelector('.stats-section');
            let animated = false;

            function isElementInViewport(el) {
                const rect = el.getBoundingClientRect();
                return (
                    rect.top >= 0 &&
                    rect.left >= 0 &&
                    rect.bottom <= (window.innerHeight || document.documentElement.clientHeight) &&
                    rect.right <= (window.innerWidth || document.documentElement.clientWidth)
                );
            }

            function checkStats() {
                if (!animated && isElementInViewport(statsSection)) {
                    animateCounter();
                    animated = true;
                }
            }

            $(window).on('scroll', checkStats);
            checkStats(); // Check on page load
        });
    </script>
