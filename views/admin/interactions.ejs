        <!-- Interactions Content Start -->
        <section class="interactions-content pt-80 pb-120">
            <div class="container">
                <!-- Header with Stats -->
                <div class="interactions-header wow fadeInUp" data-wow-delay="100ms">
                    <div class="row align-items-center">
                        <div class="col-lg-8">
                            <h3 class="mb-3">
                                <i class="fas fa-history text-primary me-2"></i>
                                Interaction Management
                            </h3>
                            <p class="text-muted mb-0">View all interactions across the system. Filter by type, operator, client, or date range.</p>
                        </div>
                        <div class="col-lg-4 text-lg-end">
                            <a href="/interactions/create" class="thm-btn">
                                <i class="fas fa-plus me-2"></i>Log New Interaction
                            </a>
                        </div>
                    </div>
                </div>

               <!-- Stats Cards -->
<div class="row mb-5 wow fadeInUp" data-wow-delay="200ms">
    <%
        // Calculate statistics directly in template
        let completedInteractions = 0;
        let emergencyInteractions = 0;
        let todayInteractions = 0;
        let thisWeekInteractions = 0;
        
        const today = new Date();
        const weekStart = new Date(today);
        weekStart.setDate(today.getDate() - today.getDay());
        weekStart.setHours(0, 0, 0, 0);
        
        for (let i = 0; i < interactions.length; i++) {
            const interaction = interactions[i];
            const interactionDate = new Date(interaction.startTime);
            
            if (interaction.status === 'completed') {
                completedInteractions++;
            }
            
            if (interaction.type === 'emergency') {
                emergencyInteractions++;
            }
            
            if (interactionDate.toDateString() === today.toDateString()) {
                todayInteractions++;
            }
            
            if (interactionDate >= weekStart) {
                thisWeekInteractions++;
            }
        }
    %>
    <div class="col-xl-3 col-lg-6 col-md-6">
        <div class="stat-card">
            <h3><%= interactions.length %></h3>
            <p>Total Interactions</p>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6">
        <div class="stat-card" style="background: linear-gradient(45deg, #28a745 0%, #34d058 100%);">
            <h3><%= completedInteractions %></h3>
            <p>Completed</p>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6">
        <div class="stat-card" style="background: linear-gradient(45deg, #fd7e14 0%, #ff9d42 100%);">
            <h3><%= emergencyInteractions %></h3>
            <p>Emergency Cases</p>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 col-md-6">
        <div class="stat-card" style="background: linear-gradient(45deg, #17a2b8 0%, #20c9d8 100%);">
            <h3><%= thisWeekInteractions %></h3>
            <p>This Week</p>
        </div>
    </div>
</div>

                <!-- Filter Card -->
                <div class="filter-card wow fadeInUp" data-wow-delay="300ms">
                    <h5 class="mb-4">
                        <i class="fas fa-filter text-primary me-2"></i>
                        Filter Interactions
                    </h5>
                    <form method="GET" action="/admin/interactions" class="row g-3">
                        <div class="col-lg-3">
                            <select class="form-select" name="type">
                                <option value="all">All Types</option>
                                <option value="visit" <%= (typeof type !== 'undefined' && type === 'visit') ? 'selected' : '' %>>Visit</option>
                                <option value="phone_call" <%= (typeof type !== 'undefined' && type === 'phone_call') ? 'selected' : '' %>>Phone Call</option>
                                <option value="video_call" <%= (typeof type !== 'undefined' && type === 'video_call') ? 'selected' : '' %>>Video Call</option>
                                <option value="emergency" <%= (typeof type !== 'undefined' && type === 'emergency') ? 'selected' : '' %>>Emergency</option>
                                <option value="medication" <%= (typeof type !== 'undefined' && type === 'medication') ? 'selected' : '' %>>Medication</option>
                                <option value="assessment" <%= (typeof type !== 'undefined' && type === 'assessment') ? 'selected' : '' %>>Assessment</option>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <select class="form-select" name="operator">
                                <option value="all">All Operators</option>
                                <% operators.forEach(function(op) { %>
                                    <option value="<%= op._id %>" 
                                            <%= (typeof operator !== 'undefined' && operator === op._id.toString()) ? 'selected' : '' %>>
                                        <%= op.firstName %> <%= op.lastName %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <select class="form-select" name="client">
                                <option value="all">All Clients</option>
                                <% clients.forEach(function(c) { %>
                                    <option value="<%= c._id %>" 
                                            <%= (typeof filterClient !== 'undefined' && filterClient === c._id.toString()) ? 'selected' : '' %>>
                                        <%= c.firstName %> <%= c.lastName %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <select class="form-select" name="status">
                                <option value="all">All Status</option>
                                <option value="completed" <%= (typeof status !== 'undefined' && status === 'completed') ? 'selected' : '' %>>Completed</option>
                                <option value="in_progress" <%= (typeof status !== 'undefined' && status === 'in_progress') ? 'selected' : '' %>>In Progress</option>
                                <option value="draft" <%= (typeof status !== 'undefined' && status === 'draft') ? 'selected' : '' %>>Draft</option>
                                <option value="cancelled" <%= (typeof status !== 'undefined' && status === 'cancelled') ? 'selected' : '' %>>Cancelled</option>
                            </select>
                        </div>
                        <div class="col-lg-6 mt-3">
                            <label class="form-label">Date Range</label>
                            <div class="input-group">
                                <input type="date" class="form-control" name="startDate" 
                                       value="<%= typeof startDate !== 'undefined' ? startDate : '' %>" placeholder="Start Date">
                                <span class="input-group-text bg-light border-0">to</span>
                                <input type="date" class="form-control" name="endDate" 
                                       value="<%= typeof endDate !== 'undefined' ? endDate : '' %>" placeholder="End Date">
                            </div>
                        </div>
                        <div class="col-lg-6 mt-5">
                            <button type="submit" class="thm-btn w-100">
                                <i class="fas fa-filter me-2"></i>Apply Filters
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Interactions Table Card -->
                <div class="interactions-table-card wow fadeInUp" data-wow-delay="400ms">
                    <% if (interactions.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="time-cell">Date & Time</th>
                                        <th>Interaction</th>
                                        <th>Client</th>
                                        <th>Operator</th>
                                        <th>Type</th>
                                        <th>Duration</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% interactions.forEach(function(interaction) { %>
                                        <tr>
                                            <td class="time-cell">
                                                <div class="date-display"><%= moment(interaction.startTime).format('MMM D, YYYY') %></div>
                                                <div class="time-display"><%= moment(interaction.startTime).format('h:mm A') %></div>
                                            </td>
                                            <td>
                                                <h6 class="mb-1"><%= interaction.title %></h6>
                                                <small class="text-muted"><%= interaction.location || 'No location' %></small>
                                            </td>
                                            <td>
                                                <% if (interaction.client) { %>
                                                    <span class="client-badge">
                                                        <i class="fas fa-user me-1"></i>
                                                        <%= interaction.client.firstName %> <%= interaction.client.lastName %>
                                                        <% if (interaction.client.referenceId) { %>
                                                            <br><small class="opacity-75">ID: <%= interaction.client.referenceId %></small>
                                                        <% } %>
                                                    </span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary">Client not found</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (interaction.operator) { %>
                                                    <span class="operator-badge">
                                                        <i class="fas fa-user-md me-1"></i>
                                                        <%= interaction.operator.firstName %> <%= interaction.operator.lastName %>
                                                    </span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary">No operator</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <%
                                                    let typeIcon = 'clipboard';
                                                    if (interaction.type === 'visit') typeIcon = 'home';
                                                    else if (interaction.type === 'phone_call') typeIcon = 'phone';
                                                    else if (interaction.type === 'video_call') typeIcon = 'video';
                                                    else if (interaction.type === 'emergency') typeIcon = 'exclamation-triangle';
                                                    else if (interaction.type === 'medication') typeIcon = 'pills';
                                                %>
                                                <span class="type-badge type-<%= interaction.type %>">
                                                    <i class="fas fa-<%= typeIcon %> me-1"></i>
                                                    <%= interaction.type.replace('_', ' ') %>
                                                </span>
                                            </td>
                                            <td>
                                                <% 
                                                    let durationText = 'N/A';
                                                    if (interaction.duration) {
                                                        let durationHtml = '';
                                                        if (interaction.duration.hours > 0) {
                                                            durationHtml += interaction.duration.hours + 'h ';
                                                        }
                                                        durationHtml += interaction.duration.minutes + 'm';
                                                        durationText = durationHtml;
                                                    } else if (interaction.endTime) {
                                                        const start = new Date(interaction.startTime);
                                                        const end = new Date(interaction.endTime);
                                                        const durationMs = end - start;
                                                        const hours = Math.floor(durationMs / (1000 * 60 * 60));
                                                        const minutes = Math.floor((durationMs % (1000 * 60 * 60)) / (1000 * 60));
                                                        
                                                        let durationHtml = '';
                                                        if (hours > 0) {
                                                            durationHtml += hours + 'h ';
                                                        }
                                                        durationHtml += minutes + 'm';
                                                        durationText = durationHtml;
                                                    }
                                                %>
                                                <% if (durationText !== 'N/A') { %>
                                                    <div class="duration-badge">
                                                        <%= durationText %>
                                                    </div>
                                                <% } else { %>
                                                    <span class="text-muted">N/A</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <%
                                                    let statusIcon = 'check-circle';
                                                    if (interaction.status === 'in_progress') statusIcon = 'sync-alt';
                                                    else if (interaction.status === 'draft') statusIcon = 'edit';
                                                    else if (interaction.status === 'cancelled') statusIcon = 'times-circle';
                                                %>
                                                <span class="status-badge status-<%= interaction.status %>">
                                                    <i class="fas fa-<%= statusIcon %> me-1"></i>
                                                    <%= interaction.status.replace('_', ' ') %>
                                                </span>
                                            </td>
                                            <td>
                                                <div class="action-buttons">
                                                    <a href="/admin/interactions/<%= interaction._id %>" 
                                                       class="action-btn action-btn-view" 
                                                       title="View Details">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="empty-state">
                            <div class="empty-state-icon">
                                <i class="fas fa-clipboard-list"></i>
                            </div>
                            <h4 class="text-muted mb-3">No Interactions Found</h4>
                            <p class="text-muted mb-4">
                                <% 
                                    let message = "No interactions have been logged yet.";
                                    if (typeof type !== 'undefined' && type !== 'all') {
                                        message = "No interactions found with type " + type.replace('_', ' ') + ".";
                                    } else if (typeof operator !== 'undefined' && operator !== 'all') {
                                        message = "No interactions found for the selected operator.";
                                    } else if (typeof filterClient !== 'undefined' && filterClient !== 'all') {
                                        message = "No interactions found for the selected client.";
                                    } else if (typeof status !== 'undefined' && status !== 'all') {
                                        message = "No interactions found with status " + status.replace('_', ' ') + ".";
                                    } else if ((typeof startDate !== 'undefined' && startDate) || (typeof endDate !== 'undefined' && endDate)) {
                                        message = "No interactions found within the selected date range.";
                                    }
                                %>
                                <%= message %>
                            </p>
                            <a href="/interactions/create" class="thm-btn">
                                <i class="fas fa-plus me-2"></i>Log Your First Interaction
                            </a>
                        </div>
                    <% } %>
                </div>

                <!-- Pagination or Info -->
                <% if (interactions.length > 0) { %>
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div class="text-muted">
                            Showing <%= interactions.length %> interaction<%= interactions.length !== 1 ? 's' : '' %>
                            <% 
                                let hasFilters = false;
                                if ((typeof type !== 'undefined' && type !== 'all') || 
                                    (typeof operator !== 'undefined' && operator !== 'all') || 
                                    (typeof filterClient !== 'undefined' && filterClient !== 'all') || 
                                    (typeof status !== 'undefined' && status !== 'all') ||
                                    (typeof startDate !== 'undefined' && startDate) || 
                                    (typeof endDate !== 'undefined' && endDate)) {
                                    hasFilters = true;
                                }
                            %>
                            <% if (hasFilters) { %>
                                <span class="ms-2">(filtered)</span>
                            <% } %>
                        </div>
                        <div>
                            <a href="/interactions/create" class="thm-btn">
                                <i class="fas fa-plus me-2"></i>Log New Interaction
                            </a>
                        </div>
                    </div>
                <% } %>
            </div>
        </section>
